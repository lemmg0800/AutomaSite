---
interface Props {
  content?: {
    badge?: string;
    title?: string;
    subtitle?: string;
    services?: Array<{
      title: string;
      description: string;
      cta?: string;
    }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Frotas & Grandes Formatos";
const title = content?.title || "Soluções em Adesivagem Automotiva e Impressão Digital";
const subtitle = content?.subtitle || "Da personalização de 1 utilitário a frotas corporativas de 50+ caminhões em Criciúma e região.";

const serviceCards = [
  {
    title: "Envelopamento de Carros, Furgões e Vans",
    description: "Projetos de alta cobertura ou meia adesivagem estratégica para veículos de vendas, técnicos e entregas.",
    image: "/leads/freitas-comunicacao-visual/0aa299d21a71460f_SITE-4-scaled-rsj5gyzb0x1da7cl.jpg",
    tag: "Veículos Leves & Médios",
    specs: ["Película Cast com proteção UV", "Cortes sem estilete na lataria", "Alta aderência em curvas"]
  },
  {
    title: "Adesivagem de Caminhões Baú e Carretas",
    description: "Aplicação em baús de alumínio corrugado e liso com cortes perfeitos e vedação térmica nas emendas.",
    image: "/leads/freitas-comunicacao-visual/d6561f4f6b47b546_SITE-1-scaled-rs8ide0udhegpoe4.jpg",
    tag: "Transporte & Logística",
    specs: ["Doca própria para caminhões", "Resistente a lavador de alta pressão", "Garantia estendida"]
  },
  {
    title: "Impressão Digital em Lonas e Vinil de 3.20m",
    description: "Impressoras industriais de alta definição para lonas backlight, banners promocionais e painéis de grande porte.",
    image: "/leads/freitas-comunicacao-visual/6637f3734f47d6a4_SITE96-scaled-rs8hzh0v6scmtilv.jpg",
    tag: "Alta Resolução",
    specs: ["Largura sem emenda de 3.20m", "Cores calibradas Pantone", "Tinta solvente com filtro UV"]
  },
  {
    title: "Adesivos Recortados e Fachadas Comerciais",
    description: "Vinil adesivo de corte eletrônico com precisão para frotas, maquinários agrícolas e identificação corporativa.",
    image: "/leads/freitas-comunicacao-visual/fcd2101153de81bc_SITE-2-scaled-rs8hrfikptcbhmae.jpg",
    tag: "Precisão Milimétrica",
    specs: ["Recorte computadorizado", "Máscara de aplicação profissional", "Ideal para logotipos"]
  }
];
---

<section id="servicos" class="py-24 bg-[#0a0f1d] border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-500/10 border border-red-500/25 text-red-400 font-bold text-xs uppercase tracking-wider">
        {badge}
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {serviceCards.map((service) => (
        <div class="group bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden hover:border-red-500/40 transition-all duration-300 flex flex-col hover:shadow-2xl hover:shadow-red-950/30">
          <div class="relative h-64 overflow-hidden bg-slate-950">
            <img 
              src={service.image} 
              alt={service.title}
              class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-md bg-red-600/90 backdrop-blur-sm text-white font-bold text-xs tracking-wider uppercase shadow-md">
                {service.tag}
              </span>
            </div>
          </div>

          <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <h3 class="text-2xl font-bold text-white group-hover:text-red-400 transition-colors">
                {service.title}
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed">
                {service.description}
              </p>
            </div>

            <div class="space-y-2 pt-4 border-t border-slate-800/80">
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Diferenciais Técnicos:</div>
              <ul class="space-y-1.5">
                {service.specs.map((spec) => (
                  <li class="flex items-center gap-2 text-xs text-slate-300">
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href="https://wa.me/5548998413320?text=Ol%C3%A1%2C%20gostaria%20de%20or%C3%A7amento%20para%20este%20servi%C3%A7o!"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-slate-800 hover:bg-red-600 text-white font-bold text-sm transition-all duration-200"
            >
              <span>Solicitar Orçamento deste Serviço</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
