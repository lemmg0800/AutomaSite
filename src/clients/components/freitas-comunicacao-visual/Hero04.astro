---
interface Props {
  content?: {
    badge?: string;
    headline?: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    stats?: Array<{ value: string; label: string }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content, client } = Astro.props;

const badge = content?.badge || "Líder em Envelopamento Comercial no Sul de SC";
const headline = content?.headline || "Transforme seus Veículos em Outdoors Móveis que Vendem Todos os Dias";
const subheadline = content?.subheadline || "Envelopamento profissional parcial e total de frotas comerciais, vans e caminhões baú com películas automotivas fundidas (Cast) e laminação com bloqueio UV.";
const primaryCtaLabel = content?.primaryCtaLabel || "Cotar Envelopamento no WhatsApp";
const primaryCtaHref = content?.primaryCtaHref || "https://wa.me/5548998413320";
const secondaryCtaLabel = content?.secondaryCtaLabel || "Ver Frotas Realizadas";
const secondaryCtaHref = content?.secondaryCtaHref || "#projetos";

const stats = content?.stats || [
  { value: "+3.500", label: "Veículos Adesivados" },
  { value: "Garantia UV", label: "Película Automotiva Cast" },
  { value: "Doca Própria", label: "Estrutura para Carretas" }
];

const bannerImg = "/leads/freitas-comunicacao-visual/4119a0c450ec570f_banner-1.jpg";
const showcaseCar1 = "/leads/freitas-comunicacao-visual/0aa299d21a71460f_SITE-4-scaled-rsj5gyzb0x1da7cl.jpg";
const showcaseCar2 = "/leads/freitas-comunicacao-visual/d6561f4f6b47b546_SITE-1-scaled-rs8ide0udhegpoe4.jpg";
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-gradient-to-b from-[#070b14] via-[#0d1527] to-[#070b14] py-20 lg:py-28">
  <!-- Subtle Grid & Lighting Background -->
  <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(rgba(239, 68, 68, 0.25) 1px, transparent 1px); background-size: 32px 32px;"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Col -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 backdrop-blur-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-red-400">{badge}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          {headline}
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed">
          {subheadline}
        </p>

        <!-- CTA Actions -->
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a
            href={primaryCtaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 via-red-500 to-red-600 text-white font-extrabold text-base shadow-xl shadow-red-600/30 hover:shadow-red-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 border border-red-400/40 group"
          >
            <svg class="w-5 h-5 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>{primaryCtaLabel}</span>
          </a>

          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-bold text-base border border-slate-700/70 hover:border-slate-500 transition-all duration-200 backdrop-blur-sm"
          >
            <span>{secondaryCtaLabel}</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Stats Bar -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-800/80">
          {stats.map((stat) => (
            <div class="space-y-1">
              <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-red-200">
                {stat.value}
              </div>
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Real Visual Showcase Col -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Main Hero Banner Card -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-red-950/50 border border-red-500/30 group">
            <img 
              src={bannerImg} 
              alt="Envelopamento de Frota Comercial Freitas" 
              class="w-full h-80 sm:h-96 object-cover transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-6">
              <span class="inline-block w-fit px-3 py-1 rounded bg-red-600 text-white font-bold text-xs uppercase tracking-wider mb-2">
                Frota Comercial
              </span>
              <p class="text-white font-semibold text-sm">
                Adesivagem de alta durabilidade com película Cast automotiva
              </p>
            </div>
          </div>

          <!-- Overlapping Floating Card 1 -->
          <div class="absolute -bottom-6 -left-6 w-48 sm:w-56 rounded-xl overflow-hidden shadow-2xl border border-slate-700 bg-slate-900/90 backdrop-blur-md p-2 hidden sm:block">
            <img 
              src={showcaseCar1} 
              alt="Veículo Padronizado" 
              class="w-full h-24 object-cover rounded-lg"
            />
            <div class="pt-2 px-1 text-[11px] font-bold text-slate-300 flex items-center justify-between">
              <span>Personalização 100%</span>
              <span class="text-red-400">✓ Cast</span>
            </div>
          </div>

          <!-- Overlapping Floating Card 2 -->
          <div class="absolute -top-6 -right-6 w-44 rounded-xl overflow-hidden shadow-2xl border border-slate-700 bg-slate-900/90 backdrop-blur-md p-2 hidden sm:block">
            <img 
              src={showcaseCar2} 
              alt="Frota Entregue" 
              class="w-full h-20 object-cover rounded-lg"
            />
            <div class="pt-1.5 px-1 text-[10px] font-bold text-slate-300">
              Criciúma / SC
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
