---
interface Props {
  content?: {
    title?: string;
    subtitle?: string;
    projects?: Array<{
      title: string;
      category: string;
      description: string;
    }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const title = content?.title || "Frotas Comerciais e Comunicação Entregues";
const subtitle = content?.subtitle || "Veja os veículos e projetos padronizados pela equipe Freitas em Criciúma e em todo o estado de SC.";

const projectList = [
  {
    title: "Envelopamento de Caminhão Baú e Carretas",
    category: "Transporte Rodoviário",
    desc: "Adesivagem de alta resistência para rodovias, resistente a intempéries e lavagens com desengraxante.",
    image: "/leads/freitas-comunicacao-visual/c93b220038ae4d20_1-scaled-rs8hikvacz845t58qy918.jpg"
  },
  {
    title: "Padronização Completa de Frota Comercial",
    category: "Frotas de Vendas",
    desc: "Mais de 16 veículos adesivados no mesmo padrão cromático com calibração Pantone perfeita.",
    image: "/leads/freitas-comunicacao-visual/39767bfbc12ce80a_707510311_1507623157410242_565.webp"
  },
  {
    title: "Comunicação Visual e Letras Caixa",
    category: "Fachadas Comerciais",
    desc: "Letreiros luminosos e identidade externa para estabelecimentos corporativos em Criciúma.",
    image: "/leads/freitas-comunicacao-visual/035755d205393ab8_9999999-1-scaled-rs8i6ogbl27rt.jpg"
  },
  {
    title: "Adesivagem de Vans e Veículos Técnicos",
    category: "Veículos Utilitários",
    desc: "Envelopamento parcial com recorte de logotipo e contato telefônico em vinil Cast.",
    image: "/leads/freitas-comunicacao-visual/653404e25087231e_632810509_18173086147385545_82.webp"
  },
  {
    title: "Personalização de Pick-ups e Frotas de Campo",
    category: "Agronegócio & Serviços",
    desc: "Película com proteção anti-risco e resistência a pedriscos de estradas não pavimentadas.",
    image: "/leads/freitas-comunicacao-visual/70425dbb2eee0725_717665457_18185210626385545_96.webp"
  },
  {
    title: "Impressão e Aplicação em Painéis e Fachadas",
    category: "Comunicação Externa",
    desc: "Lona frontlight 440g e vinil de grande escala para máxima visibilidade visual urbana.",
    image: "/leads/freitas-comunicacao-visual/c3ce22f0823a4663_794192599_1394787919311400_641.webp"
  }
];
---

<section id="projetos" class="py-24 bg-[#070b14] border-t border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-red-500">Portfólio Real</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {title}
        </h2>
        <p class="text-slate-300 text-base sm:text-lg">
          {subtitle}
        </p>
      </div>
      <a 
        href="https://wa.me/5548998413320"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm transition-all duration-200 self-start md:self-auto shadow-lg shadow-red-900/40"
      >
        <span>Solicitar Orçamento de Frota</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projectList.map((project) => (
        <div class="group relative rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 hover:border-red-500/50 transition-all duration-300 flex flex-col">
          <div class="relative h-64 overflow-hidden">
            <img 
              src={project.image} 
              alt={project.title}
              class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 rounded bg-slate-900/80 backdrop-blur-md text-red-400 text-xs font-bold border border-red-500/20">
                {project.category}
              </span>
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
            <h3 class="text-lg font-bold text-white group-hover:text-red-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {project.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
