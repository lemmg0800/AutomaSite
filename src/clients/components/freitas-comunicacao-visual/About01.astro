---
interface Props {
  content?: {
    badge?: string;
    title?: string;
    description?: string;
    stats?: Array<{ number: string; label: string }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content, client } = Astro.props;

const badge = content?.badge || "Galpão e Equipamentos Próprios";
const title = content?.title || "Estrutura Dedicada para Frotas de Todos os Portes em Criciúma";
const description = content?.description || "A Freitas Comunicação Visual possui galpão com pé-direito elevado e doca para manobra de caminhões na Rua Álvaro Catão, em Criciúma. Nossa equipe de aplicadores é treinada segundo as melhores práticas internacionais de adesivagem automotiva, garantindo precisão milimétrica sem riscos na lataria.";

const stats = content?.stats || [
  { number: "Criciúma / SC", label: "Galpão Climatizado" },
  { number: "3.20m", label: "Largura Máx. Impressão" },
  { number: "+3.500", label: "Veículos Padronizados" }
];

const aboutImg = "/leads/freitas-comunicacao-visual/fe0b876fa5835ad1_bg2.jpg";
const fleetBadgeImg = "/leads/freitas-comunicacao-visual/4c8c3d85a97ef692_advertising-branco-300x300.png";
---

<section id="sobre" class="py-24 bg-[#0a0f1d] border-t border-slate-800 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Visual Column -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-2xl overflow-hidden border border-slate-700 shadow-2xl shadow-black/60">
          <img 
            src={aboutImg} 
            alt="Galpão e Oficina Freitas Comunicação Visual" 
            class="w-full h-[420px] object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-slate-900/90 backdrop-blur-md border border-slate-700/80 flex items-center gap-4">
            <img src={fleetBadgeImg} alt="Selo Qualidade" class="w-12 h-12 object-contain filter invert" />
            <div>
              <div class="text-white font-bold text-sm">Estrutura Fechada e Climatizada</div>
              <div class="text-slate-400 text-xs">Aplicação livre de poeira para acabamento perfeito</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 font-bold text-xs uppercase tracking-wider">
          {badge}
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          {description}
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-800">
          {stats.map((s) => (
            <div class="space-y-1">
              <div class="text-2xl font-black text-red-500">{s.number}</div>
              <div class="text-xs text-slate-400 font-medium">{s.label}</div>
            </div>
          ))}
        </div>

        <div class="pt-4">
          <a 
            href="https://wa.me/5548998413320?text=Ol%C3%A1%2C%20gostaria%20de%20visitar%20o%20galp%C3%A3o%20ou%20solicitar%20or%C3%A7amento!"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm shadow-lg shadow-red-900/30 transition-all"
          >
            <span>Falar com Técnico Especialista</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
