---
interface Props {
  content?: {
    disclaimer?: string;
  };
  clientSlug?: string;
  client?: any;
}

const logoPath = "/leads/duka-paineis-e-imagens/98622a2151e00787_logo.png";
---

<footer class="bg-[#07080b] border-t border-slate-900 text-slate-400 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <div class="space-y-4 md:col-span-2">
        <img src={logoPath} alt="Duka Painéis e Imagens" class="h-12 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(245,158,11,0.3)]" />
        <p class="text-sm text-slate-300 max-w-md leading-relaxed">
          Estruturas monumentais, painéis industriais, pórticos e totens de rodovia com engenharia estrutural, cálculo de vento e instalação técnica no Sul de Santa Catarina.
        </p>
      </div>

      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm tracking-wider uppercase text-amber-500">Parque Fabril</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Rua Luiza Barp, 230<br />
          Distrito Industrial 1ª Linha<br />
          Içara / Criciúma - SC
        </p>
        <p class="text-xs text-slate-300">
          Telefone Fábrica: (48) 3432-3740
        </p>
      </div>

      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm tracking-wider uppercase text-amber-500">Plantão Comercial</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          WhatsApp: (48) 98482-2827<br />
          Atendimento a Engenheiros e Arquitetos
        </p>
        <p class="text-xs text-slate-400">
          Instagram: @dukapaineis
        </p>
      </div>

    </div>

    <div class="pt-8 border-t border-slate-900 text-center text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Duka Painéis e Imagens. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
