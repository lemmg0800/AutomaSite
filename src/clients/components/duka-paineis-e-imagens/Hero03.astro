---
interface Props {
  content?: {
    badge?: string;
    headline?: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    stats?: Array<{ value: string; label: string }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Polo Metalmecânico - Distrito Industrial";
const headline = content?.headline || "Estruturas Monumentais, Painéis Industriais e Totens de Rodovia";
const subheadline = content?.subheadline || "Engenharia de precisão e fabricação pesada para indústrias, redes atacadistas e centros logísticos no Sul de SC com garantia estrutural e ART.";
const primaryCtaLabel = content?.primaryCtaLabel || "Cotar Projeto Industrial no WhatsApp";
const primaryCtaHref = content?.primaryCtaHref || "https://wa.me/5548984822827";
const secondaryCtaLabel = content?.secondaryCtaLabel || "Ver Obras Industriais";
const secondaryCtaHref = content?.secondaryCtaHref || "#obras";

const stats = [
  { value: "+25 Anos", label: "Tradição no Sul de SC" },
  { value: "Cálculo ART", label: "Engenharia Estrutural" },
  { value: "Distrito Ind.", label: "Parque Fabril em Içara" }
];

const sliderImg = "/leads/duka-paineis-e-imagens/1478253c975ce3b1_Slider.png";
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-gradient-to-b from-[#0b0d11] via-[#12161f] to-[#0b0d11] py-20 lg:py-24">
  <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(rgba(245, 158, 11, 0.3) 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Col -->
      <div class="lg:col-span-7 space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-400 font-black text-xs uppercase tracking-wider">
          <span class="w-2.5 h-2.5 bg-amber-500 animate-pulse"></span>
          <span>{badge}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] uppercase">
          {headline}
        </h1>

        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          {subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a
            href={primaryCtaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-600 text-slate-950 font-black text-base shadow-xl shadow-amber-950/50 hover:shadow-amber-500/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 border border-amber-300"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>{primaryCtaLabel}</span>
          </a>

          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-bold text-base border border-slate-700 hover:border-amber-500/50 transition-all duration-200"
          >
            <span>{secondaryCtaLabel}</span>
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-800">
          {stats.map((s) => (
            <div class="space-y-1">
              <div class="text-2xl font-black text-amber-400">{s.value}</div>
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">{s.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Real Visual Showcase Card -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
          <img 
            src={sliderImg} 
            alt="Duka Painéis e Imagens" 
            class="w-full h-80 sm:h-96 object-cover transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex flex-col justify-end p-6">
            <span class="inline-block w-fit px-3 py-1 rounded bg-amber-500 text-black font-black text-xs uppercase tracking-wider mb-2">
              Serralheria Pesada
            </span>
            <h3 class="text-white font-bold text-lg">Pórticos, Galpões e Totens com ART</h3>
            <p class="text-xs text-slate-300 mt-1">Montagem com caminhão munck próprio e equipe certificada NR-35</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
