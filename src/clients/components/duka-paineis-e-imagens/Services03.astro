---
interface Props {
  content?: {
    badge?: string;
    title?: string;
    subtitle?: string;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Soluções de Engenharia Visual";
const title = content?.title || "Fabricação Própria para Grandes Empreendimentos";
const subtitle = content?.subtitle || "Capacidade técnica para montagem de estruturas pesadas em todo o estado de Santa Catarina.";

const services = [
  {
    title: "Painéis Industriais e Fachadas Monumentais",
    desc: "Revestimentos em ACM e chapas metálicas tratadas contra corrosão marinha para galpões e indústrias.",
    image: "/leads/duka-paineis-e-imagens/5bfa3003c2459256_placaimg2.png",
    tag: "Galpões & Indústrias"
  },
  {
    title: "Totens Rodoviários de Grande Escala",
    desc: "Projetos estruturais completos com sapata de concreto, cálculo de vento e iluminação embutida de longo alcance.",
    image: "/leads/duka-paineis-e-imagens/1f01b5c15861e22d_totemimg1.png",
    tag: "Alta Visibilidade"
  },
  {
    title: "Letras Caixa em Metal e Aço Galvanizado",
    desc: "Letreiros tridimensionais com corte eletrônico, pintura eletrostática a pó e iluminação indireta halo.",
    image: "/leads/duka-paineis-e-imagens/38747698574bcd64_letraimg1.png",
    tag: "Durabilidade Superior"
  },
  {
    title: "Adesivagem de Frotas Pesadas e Maquinários",
    desc: "Identificação técnica de caminhões basculantes, carretas, tratores e frotas corporativas de logística.",
    image: "/leads/duka-paineis-e-imagens/1ae9def09d596ba0_carroimg1.png",
    tag: "Logística & Transporte"
  }
];
---

<section id="servicos" class="py-24 bg-[#0e1118] border-t border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-400 font-black text-xs uppercase tracking-wider">
        {badge}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight uppercase">
        {title}
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((item) => (
        <div class="group bg-[#0b0d11] border border-slate-800 hover:border-amber-500/50 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col hover:shadow-2xl hover:shadow-amber-950/20">
          <div class="relative h-64 overflow-hidden bg-slate-950">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b0d11] via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded bg-amber-500 text-black font-black text-xs uppercase shadow">
                {item.tag}
              </span>
            </div>
          </div>

          <div class="p-8 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="text-2xl font-bold text-white group-hover:text-amber-400 transition-colors">
                {item.title}
              </h3>
              <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                {item.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80">
              <a 
                href="https://wa.me/5548984822827?text=Ol%C3%A1%2C%20quero%20um%20or%C3%A7amento%20para%20este%20servi%C3%A7o!"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-bold text-sm"
              >
                <span>Solicitar Medição Técnica Gratuita</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
