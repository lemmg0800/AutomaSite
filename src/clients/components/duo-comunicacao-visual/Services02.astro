---
interface Props {
  content?: {
    badge?: string;
    title?: string;
    subtitle?: string;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Soluções Visuais Completas";
const title = content?.title || "O que a Duo Comunicação Visual Produz para o seu Negócio";
const subtitle = content?.subtitle || "Da criação conceitual à instalação final na sua empresa em Santa Catarina.";

const services = [
  {
    title: "Letreiros Luminosos & Face Acrílica",
    desc: "Letras em bloco de alumínio, inox ou galvanizado com face em acrílico translúcido e iluminação LED interna homogênea.",
    image: "/leads/duo-comunicacao-visual/0bd8461228174df2_letras-caixa-face-acrilica-e-l.jpeg",
    tag: "Fachadas & Lojas"
  },
  {
    title: "Neon LED Flex Sob Medida",
    desc: "Painéis iluminados para bares, cafés, recepções e estúdios. Cores vibrantes com fita de silicone flexível e base acrílica cristal.",
    image: "/leads/duo-comunicacao-visual/0647e7870262a2c9_neon-led_842_img.jpg",
    tag: "Decoração & Branding"
  },
  {
    title: "Revestimentos em ACM e Toldos",
    desc: "Estruturação de fachadas inteiras com painéis compostos de alumínio, bandejamento usinado em CNC e proteção solar.",
    image: "/leads/duo-comunicacao-visual/0b0db7e49dccf314_acm-e-toldos_23_capa.jpg",
    tag: "Comunicação Externa"
  },
  {
    title: "Sinalização Interna & Acrílico Cristal",
    desc: "Placas de identificação, wayfinding corporativo, displays e ambientação de consultórios e clínicas com estética clean.",
    image: "/leads/duo-comunicacao-visual/046cd35ae24219fc_sinalizacao-interna_capa.jpg",
    tag: "Arquitetura Corporativa"
  }
];
---

<section id="servicos" class="py-24 bg-[#0d091e] border-t border-purple-900/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-xs font-bold uppercase tracking-widest">
        {badge}
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        {title}
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((item) => (
        <div class="group relative rounded-3xl overflow-hidden bg-gradient-to-br from-purple-950/40 via-slate-900 to-[#090714] border border-purple-500/20 hover:border-pink-500/50 transition-all duration-300 shadow-xl hover:shadow-[0_0_30px_rgba(236,72,153,0.15)] flex flex-col">
          <div class="relative h-64 overflow-hidden bg-slate-950">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#090714] via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-full bg-pink-600/90 text-white font-bold text-xs shadow-md">
                {item.tag}
              </span>
            </div>
          </div>

          <div class="p-8 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <h3 class="text-2xl font-bold text-white group-hover:text-pink-400 transition-colors">
                {item.title}
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed">
                {item.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-purple-900/40">
              <a 
                href="https://wa.me/5548996226383?text=Ol%C3%A1%2C%20quero%20um%20projeto%20deste%20servi%C3%A7o!"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-pink-400 hover:text-pink-300 font-bold text-sm transition-colors"
              >
                <span>Consultar Possibilidades Técnicas</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
