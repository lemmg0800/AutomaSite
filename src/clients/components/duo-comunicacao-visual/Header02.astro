---
interface Props {
  content?: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  clientSlug?: string;
  client?: any;
}

const { content, client } = Astro.props;

const navLinks = content?.navLinks || [
  { label: "Neon LED", href: "#servicos" },
  { label: "Letras Caixa", href: "#servicos" },
  { label: "Fachadas ACM", href: "#servicos" },
  { label: "Galeria de Obras", href: "#galeria" },
  { label: "Contato", href: "#contato" }
];
const ctaLabel = content?.ctaLabel || "Orçamento WhatsApp";
const phone = client?.business?.phone || "(48) 99622-6383";
const whatsappUrl = `https://wa.me/55${phone.replace(/\D/g, '')}?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20projeto%20luminoso!`;
const logoPath = "/leads/duo-comunicacao-visual/b304f04210abbe25_brand-white.png";
---

<header class="sticky top-0 z-50 bg-[#090714]/90 backdrop-blur-xl border-b border-purple-500/20 shadow-2xl shadow-purple-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img 
          src={logoPath} 
          alt="Duo Comunicação Visual" 
          class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105 filter drop-shadow-[0_0_10px_rgba(236,72,153,0.5)]"
          loading="eager"
        />
        <div class="hidden sm:flex flex-col border-l border-purple-800/50 pl-3">
          <span class="text-[11px] font-black tracking-widest text-pink-500 uppercase">Neon LED & Fachadas</span>
          <span class="text-[10px] text-purple-300/70">Içara / Criciúma - SC</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a 
            href={link.href}
            class="text-sm font-semibold tracking-wide text-slate-300 hover:text-pink-400 transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA Action -->
      <div class="flex items-center gap-3">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 hover:from-pink-500 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-pink-600/30 hover:shadow-pink-500/50 transition-all duration-300 transform hover:-translate-y-0.5 border border-pink-400/40"
        >
          <span class="w-2 h-2 rounded-full bg-pink-300 animate-ping"></span>
          <span>{ctaLabel}</span>
        </a>
      </div>

    </div>
  </div>
</header>
