---
interface Props {
  content?: {
    badge?: string;
    headline?: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    stats?: Array<{ value: string; label: string }>;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Design Luminoso & Sinalização Comercial";
const headline = content?.headline || "Ilumine sua Marca com Neon LED e Letreiros de Alto Padrão";
const subheadline = content?.subheadline || "Desenvolvemos fachadas em ACM com iluminação indireta, letreiros em acrílico cristal com face translúcida e projetos personalizados de Neon LED que destacam seu negócio de dia e de noite.";
const primaryCtaLabel = content?.primaryCtaLabel || "Criar Projeto Luminoso no WhatsApp";
const primaryCtaHref = content?.primaryCtaHref || "https://wa.me/5548996226383";
const secondaryCtaLabel = content?.secondaryCtaLabel || "Conhecer Obras Realizadas";
const secondaryCtaHref = content?.secondaryCtaHref || "#galeria";

const heroNeonImg = "/leads/duo-comunicacao-visual/0647e7870262a2c9_neon-led_842_img.jpg";
const heroLetreiroImg = "/leads/duo-comunicacao-visual/0bd8461228174df2_letras-caixa-face-acrilica-e-l.jpeg";
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center overflow-hidden bg-[#090714] py-20 lg:py-28">
  <!-- Glowing Neon Radial Orbs -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-r from-pink-600/20 via-purple-600/20 to-indigo-600/20 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute -bottom-20 left-10 w-80 h-80 bg-pink-500/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute -top-20 right-10 w-80 h-80 bg-indigo-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 text-center">
    
    <!-- Top Glowing Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-500/10 border border-pink-500/30 backdrop-blur-md mb-8 shadow-[0_0_15px_rgba(236,72,153,0.2)]">
      <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse shadow-[0_0_8px_#ec4899]"></span>
      <span class="text-xs font-bold uppercase tracking-widest text-pink-300">{badge}</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight max-w-5xl mx-auto leading-[1.1] mb-6">
      Ilumine sua Marca com <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-purple-300 to-indigo-300 filter drop-shadow-[0_0_20px_rgba(236,72,153,0.3)]">Neon LED</span> e Fachadas Exclusivas
    </h1>

    <!-- Subheadline -->
    <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed mb-10">
      {subheadline}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href={primaryCtaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-400 hover:to-indigo-500 text-white font-extrabold text-base shadow-xl shadow-pink-600/40 hover:shadow-pink-500/60 transition-all duration-300 transform hover:scale-105 border border-pink-300/40"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>{primaryCtaLabel}</span>
      </a>

      <a
        href={secondaryCtaHref}
        class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-purple-500/30 hover:border-pink-500/50 transition-all duration-200 backdrop-blur-md"
      >
        <span>{secondaryCtaLabel}</span>
        <svg class="w-4 h-4 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Dual Showcase Glow Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      
      <!-- Card 1: Neon LED -->
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-b from-purple-900/30 to-black/80 border border-pink-500/40 p-3 shadow-[0_0_30px_rgba(236,72,153,0.15)] group hover:border-pink-400 transition-all duration-300">
        <div class="relative h-72 sm:h-80 rounded-2xl overflow-hidden bg-slate-950">
          <img 
            src={heroNeonImg} 
            alt="Neon LED Duo Comunicação Visual" 
            class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex flex-col justify-end p-6 text-left">
            <span class="inline-block w-fit px-3 py-1 rounded-full bg-pink-600/90 text-white font-bold text-xs uppercase tracking-wider mb-2">
              Neon Flex 12V
            </span>
            <h3 class="text-xl font-bold text-white">Letreiros e Painéis de Neon LED</h3>
            <p class="text-xs text-purple-200 mt-1">Brilho intenso, baixo consumo e corte a laser perfeito</p>
          </div>
        </div>
      </div>

      <!-- Card 2: Letras Caixa Face Acrílica -->
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-b from-purple-900/30 to-black/80 border border-indigo-500/40 p-3 shadow-[0_0_30px_rgba(99,102,241,0.15)] group hover:border-indigo-400 transition-all duration-300">
        <div class="relative h-72 sm:h-80 rounded-2xl overflow-hidden bg-slate-950">
          <img 
            src={heroLetreiroImg} 
            alt="Letras Caixa Face Acrílica Duo" 
            class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex flex-col justify-end p-6 text-left">
            <span class="inline-block w-fit px-3 py-1 rounded-full bg-indigo-600/90 text-white font-bold text-xs uppercase tracking-wider mb-2">
              Iluminação LED Interna
            </span>
            <h3 class="text-xl font-bold text-white">Letras Caixa & Face Translúcida</h3>
            <p class="text-xs text-indigo-200 mt-1">Acabamento refinado para fachadas corporativas</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Quick Credentials Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto mt-16 pt-10 border-t border-purple-900/40">
      <div>
        <div class="text-2xl font-black text-pink-400">LED Samsung</div>
        <div class="text-xs text-slate-400 mt-1">Módulos de alta durabilidade</div>
      </div>
      <div>
        <div class="text-2xl font-black text-purple-400">100% Acrílico Cast</div>
        <div class="text-xs text-slate-400 mt-1">Sem amarelamento</div>
      </div>
      <div>
        <div class="text-2xl font-black text-indigo-400">Içara / Criciúma</div>
        <div class="text-xs text-slate-400 mt-1">Instalação própria</div>
      </div>
      <div>
        <div class="text-2xl font-black text-pink-400">Garantia 2 Anos</div>
        <div class="text-xs text-slate-400 mt-1">Assistência técnica</div>
      </div>
    </div>

  </div>
</section>
