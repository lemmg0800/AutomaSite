---
interface Props {
  content?: {
    disclaimer?: string;
  };
  clientSlug?: string;
  client?: any;
}

const { client } = Astro.props;
const logoPath = "/leads/duo-comunicacao-visual/b304f04210abbe25_brand-white.png";
---

<footer class="bg-[#06040d] border-t border-purple-950 text-slate-400 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <div class="space-y-4 md:col-span-2">
        <img src={logoPath} alt="Duo Comunicação Visual" class="h-10 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(236,72,153,0.3)]" />
        <p class="text-sm text-slate-300 max-w-md leading-relaxed">
          Especialistas em projetos luminosos de Neon LED, letras caixa translúcidas, fachadas em ACM e comunicação visual arquitetônica para marcas de destaque.
        </p>
      </div>

      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm tracking-wider uppercase">Localização & Contato</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Rodovia Jorge Zanatta, 6563<br />
          Presidente Vargas, Içara / Criciúma - SC
        </p>
        <p class="text-xs text-pink-400 font-bold">
          WhatsApp: (48) 99622-6383
        </p>
      </div>

      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm tracking-wider uppercase">Horário de Atendimento</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Segunda a Sexta: 08h às 18h<br />
          Visitas técnicas agendadas em toda a região
        </p>
        <a 
          href="https://instagram.com/duoonline" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block text-xs text-purple-400 hover:text-pink-400 font-bold mt-2"
        >
          Instagram: @duoonline
        </a>
      </div>

    </div>

    <div class="pt-8 border-t border-purple-900/30 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Duo Comunicação Visual. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
