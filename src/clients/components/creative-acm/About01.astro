---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    description?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section id="sobre" class="py-24 bg-[#030712] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Coluna Esquerda: Texto Institucional -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-orange-500/30 bg-orange-500/10 text-orange-400">
          <span>PARQUE FABRIL PRÓPRIO</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight font-['Montserrat',sans-serif]">
          {content?.title || "Fabricação Própria e Excelência em Cada Detalhe"}
        </h2>

        <p class="text-base text-slate-300 leading-relaxed font-light">
          Com sede própria na Av. Centenário em Criciúma, a <strong>Creative ACM</strong> possui maquinário de corte a laser CNC de última geração, dobradeiras de alta precisão e equipe interna de serralheria pesada.
        </p>

        <p class="text-sm text-slate-400 leading-relaxed font-light">
          Ao contrário de intermediários que terceirizam a produção, controlamos cada etapa do processo: desde a renderização 3D do seu projeto até a instalação estrutural com caminhão munck próprio, garantindo cumprimento rigoroso de prazos e acabamento impecável.
        </p>

        <!-- Destaques Estruturais -->
        <div class="grid grid-cols-2 gap-4 pt-4">
          <div class="p-4 rounded-xl border border-white/10 bg-slate-900/60">
            <span class="text-2xl block mb-1">🏗️</span>
            <h4 class="text-sm font-bold text-white">Munck Próprio</h4>
            <p class="text-xs text-slate-400 mt-1">Içamento com equipe habilitada NR-35</p>
          </div>
          <div class="p-4 rounded-xl border border-white/10 bg-slate-900/60">
            <span class="text-2xl block mb-1">⚡</span>
            <h4 class="text-sm font-bold text-white">Laser CNC 1500W</h4>
            <p class="text-xs text-slate-400 mt-1">Corte milimétrico em ACM, inox e acrílico</p>
          </div>
        </div>
      </div>

      <!-- Coluna Direita: Imagens Reais da Sede e da Equipe -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Foto da Sede -->
          <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group aspect-[4/5]">
            <img 
              src="/leads/creative-acm/4cf437bf5cdbd91c_creative-acm-sede.png" 
              alt="Sede Creative ACM em Criciúma" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3 text-left">
              <span class="text-[10px] text-orange-400 uppercase font-bold tracking-wider">SEDE EM CRICIÚMA</span>
              <p class="text-xs font-bold text-white">Av. Centenário • Atendimento Regional</p>
            </div>
          </div>

          <!-- Foto do Caminhão Munck em Ação -->
          <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group aspect-[4/5]">
            <img 
              src="/leads/creative-acm/f0a7a1ea33ae83c1_munck-01.jpeg" 
              alt="Instalação com Caminhão Munck Próprio" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3 text-left">
              <span class="text-[10px] text-orange-400 uppercase font-bold tracking-wider">EQUIPAMENTO PRÓPRIO</span>
              <p class="text-xs font-bold text-white">Montagem Técnica Especializada</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
