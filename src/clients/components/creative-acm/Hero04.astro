---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    stats?: Array<{ value: string; label: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const phone = client?.business?.whatsapp || client?.business?.phone || '(48) 99652-8028';
const cleanPhone = phone.replace(/\D/g, '');
const whatsLink = `https://wa.me/55${cleanPhone}?text=${encodeURIComponent(`Olá! Gostaria de um orçamento para fachada em ACM com a Creative ACM.`)}`;
---

<section class="relative min-h-[90vh] flex items-center justify-center pt-28 pb-20 overflow-hidden bg-[#030712]">
  <!-- Glow atmosférico laranja/âmbar -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-orange-500/15 blur-[160px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Coluna Esquerda: Conteúdo Estratégico -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Tag / Badge de Nicho -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase mb-6 border border-orange-500/30 bg-orange-500/10 text-orange-400 shadow-sm backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
          <span>Fachadas Comerciais em ACM • Criciúma e Região</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] mb-6 font-['Montserrat',sans-serif]">
          Transforme a Fachada da sua Empresa em um <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-400 to-orange-500">Ímã de Novos Clientes</span>
        </h1>

        <p class="text-lg text-slate-300 font-normal leading-relaxed max-w-2xl mb-8">
          Projetos arquitetônicos em ACM 4mm, letreiros luminosos em LED IP67, totens autoportantes e corte a laser CNC de alta precisão. Do projeto 3D à instalação com caminhão munck próprio.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a 
            href={whatsLink}
            target="_blank"
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold text-white transition-all duration-300 transform hover:-translate-y-0.5 shadow-xl flex items-center justify-center gap-2.5 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700"
            style="box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.4);"
          >
            <span>Solicitar Orçamento no WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          <a 
            href="#obras"
            class="w-full sm:w-auto px-6 py-4 rounded-xl text-sm font-semibold text-slate-200 border border-white/15 bg-white/5 hover:bg-white/10 hover:text-white transition-all duration-200 backdrop-blur-sm flex items-center justify-center"
          >
            Ver Portfólio de Obras
          </a>
        </div>

        <!-- Métricas Rápidas -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-white/10 w-full">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-orange-400 font-mono">+1.000</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Obras Entregues</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono">ACM 4mm</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Pintura PVDF Kynar</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono">100%</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Frota e Munck Próprio</div>
          </div>
        </div>
      </div>

      <!-- Coluna Direita: Showcase com FOTO REAL da Fachada da Creative ACM -->
      <div class="lg:col-span-5 relative">
        <!-- Moldura com efeito Glow -->
        <div class="relative rounded-2xl p-2 bg-gradient-to-b from-orange-500/20 via-white/5 to-transparent border border-white/10 shadow-2xl backdrop-blur-xl">
          
          <div class="relative overflow-hidden rounded-xl aspect-[4/3] bg-slate-950 group">
            <img 
              src="/leads/creative-acm/817d378da7bc9913_acm-01.jpg" 
              alt="Obra de Fachada em ACM Creative ACM" 
              class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
            
            <!-- Legenda sobre a imagem real -->
            <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold tracking-widest text-orange-400 bg-orange-950/80 px-2 py-0.5 rounded border border-orange-500/30">OBRA REAL EXECUTADA</span>
                <h3 class="text-base font-bold text-white mt-1">Revestimento em ACM & Letreiro LED</h3>
                <p class="text-xs text-slate-300">Criciúma / SC • Execução Creative ACM</p>
              </div>
            </div>
          </div>

          <!-- Micro Badge Flutuante com Munck e Frota -->
          <div class="absolute -bottom-6 -left-6 bg-slate-900/95 border border-white/15 px-4 py-3 rounded-xl shadow-2xl backdrop-blur-md flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center font-bold text-lg">
              🏗️
            </div>
            <div>
              <div class="text-xs font-bold text-white">Instalação com Munck Próprio</div>
              <div class="text-[10px] text-slate-400">Sem terceirização, máxima segurança</div>
            </div>
          </div>

          <!-- Micro Badge Flutuante com Garantia -->
          <div class="absolute -top-4 -right-4 bg-slate-900/95 border border-white/15 px-3 py-2 rounded-xl shadow-xl backdrop-blur-md flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <span class="text-[11px] font-bold text-white">Garantia Estrutural</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
