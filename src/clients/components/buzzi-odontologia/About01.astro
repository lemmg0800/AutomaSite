---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    text1?: string;
    text2?: string;
    image?: string;
    highlights?: Array<{ value: string; label: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const doctorImg = content?.image || "/clients/buzzi-odontologia/dra-fernanda.jpg";
---

<section id="sobre" class="py-20 md:py-28 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Coluna da Foto da Dra. Fernanda Buzzi -->
      <div class="lg:col-span-5 relative order-2 lg:order-1">
        <div class="relative mx-auto max-w-md">
          <!-- Moldura decorativa -->
          <div class="absolute -inset-3 bg-gradient-to-tr from-teal-500/20 to-emerald-500/20 rounded-3xl blur-lg"></div>
          
          <div class="relative rounded-2xl overflow-hidden shadow-xl border-4 border-slate-50 bg-white">
            <img 
              src={doctorImg} 
              alt="Dra. Fernanda Buzzi - Responsável Técnica da Buzzi Odontologia" 
              class="w-full h-auto object-cover" 
            />
            <div class="p-5 bg-gradient-to-b from-white to-slate-50 border-t border-slate-100 text-center">
              <h4 class="text-xl font-bold text-slate-900 font-['Playfair_Display',serif]">Dra. Fernanda Buzzi</h4>
              <p class="text-xs font-semibold text-teal-700 tracking-wider uppercase mt-0.5">Cirurgiã-Dentista • CRO/PR 17042</p>
              <p class="text-xs text-slate-500 mt-2">Formada pela Universidade Tuiuti do Paraná • Especialista em Ortodontia</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Coluna de Texto e Filosofia da Clínica -->
      <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-teal-200 bg-teal-50/70 text-teal-800">
          <span>{content?.badge || "Corpo Clínico & Propósito"}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight font-['Playfair_Display',serif]">
          {content?.title || "Tratamento de Excelência com Quem Realmente Ouve Você"}
        </h2>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
          A <strong>Buzzi Odontologia</strong> nasceu no bairro Fanny com uma missão clara: desmistificar o medo de ir ao dentista, oferecendo um atendimento verdadeiramente humanizado, ético e focado no bem-estar integral do paciente.
        </p>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
          Sob a responsabilidade técnica da <strong>Dra. Fernanda Buzzi</strong>, unimos sólida experiência clínica, especialização em Ortodontia, atuação avançada em Implantodontia e Próteses, além de equipamentos digitais modernos para diagnósticos rápidos e precisos.
        </p>

        <!-- Grade de Valores / Diferenciais -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <span class="text-2xl">🤝</span>
            <h5 class="text-sm font-bold text-slate-900 mt-2">Empatia Total</h5>
            <p class="text-xs text-slate-500 mt-1">Consultas sem pressa e respeito ao seu tempo.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <span class="text-2xl">🔬</span>
            <h5 class="text-sm font-bold text-slate-900 mt-2">Tecnologia Segura</h5>
            <p class="text-xs text-slate-500 mt-1">Planejamento digital para resultados naturais.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <span class="text-2xl">🛡️</span>
            <h5 class="text-sm font-bold text-slate-900 mt-2">Ética & Clareza</h5>
            <p class="text-xs text-slate-500 mt-1">Planos de tratamento explicados passo a passo.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
