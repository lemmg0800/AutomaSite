---
import type { ClientConfig } from '../../schema';

interface BenefitItem {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  content: {
    title: string;
    subtitle?: string;
    items?: BenefitItem[];
    benefits?: BenefitItem[];
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const list = content?.items || content?.benefits || [];
---

<section id="diferenciais" class="py-20 md:py-28 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-teal-200 bg-teal-50 text-teal-800 shadow-sm mb-4">
        <span>Pilares da Clínica</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight font-['Playfair_Display',serif]">
        {content.title}
      </h2>
      {content.subtitle && (
        <p class="text-base text-slate-600 mt-3 font-['Plus_Jakarta_Sans',sans-serif]">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {list.map((b) => (
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
          <div class="w-12 h-12 rounded-xl bg-teal-100/80 text-teal-800 flex items-center justify-center text-2xl mb-5">
            {b.icon || "⭐"}
          </div>
          <h3 class="font-bold text-xl text-slate-900 mb-3 font-['Playfair_Display',serif]">{b.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">{b.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
