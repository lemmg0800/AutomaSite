---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    formTitle?: string;
    formSubtitle?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const phone = client?.business?.whatsapp || client?.business?.phone || '(41) 99524-4522';
const cleanPhone = phone.replace(/\D/g, '');
const address = client?.business?.address || 'Rua Maestro Francisco Antonello, 697 - Fanny, Curitiba - PR';
---

<section id="contato" class="py-20 md:py-28 bg-white border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Informações da Clínica -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-teal-200 bg-teal-50 text-teal-800">
          <span>{content?.badge || "Localização & Agendamento"}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight font-['Playfair_Display',serif]">
          {content?.title || "Venha Cuidar do Seu Sorriso na Buzzi Odontologia"}
        </h2>

        <p class="text-base text-slate-600 leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
          Estamos localizados em uma região de fácil acesso no bairro Fanny em Curitiba, com estrutura confortável, estacionamento próximo e ambiente preparado para seu bem-estar.
        </p>

        <div class="space-y-4 pt-4 text-slate-700">
          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/70">
            <span class="text-2xl">📍</span>
            <div>
              <strong class="block text-sm font-semibold text-slate-900">Endereço da Clínica:</strong>
              <p class="text-sm text-slate-600 mt-0.5">{address}</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/70">
            <span class="text-2xl">💬</span>
            <div>
              <strong class="block text-sm font-semibold text-slate-900">WhatsApp & Atendimento Direto:</strong>
              <p class="text-sm text-slate-600 mt-0.5">{phone}</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/70">
            <span class="text-2xl">⏰</span>
            <div>
              <strong class="block text-sm font-semibold text-slate-900">Horário de Atendimento:</strong>
              <p class="text-sm text-slate-600 mt-0.5">Segunda a Sexta: 08:30 às 18:30 • Sábados com horário agendado</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Interativo de Agendamento -->
      <div class="lg:col-span-6 flex items-center">
        <div class="w-full bg-slate-50 rounded-2xl p-8 sm:p-10 border border-slate-200 shadow-lg text-center">
          <div class="w-16 h-16 rounded-2xl bg-teal-100 text-teal-800 mx-auto flex items-center justify-center text-3xl mb-6 shadow-sm">
            📅
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-3 font-['Playfair_Display',serif]">
            {content?.formTitle || "Agende Sua Primeira Avaliação"}
          </h3>

          <p class="text-sm text-slate-600 mb-8 max-w-md mx-auto font-['Plus_Jakarta_Sans',sans-serif]">
            {content?.formSubtitle || "Fale diretamente com nossa recepção para escolher o melhor dia e horário. Sem filas e com acolhimento exclusivo."}
          </p>

          <a 
            href={`https://wa.me/55${cleanPhone}?text=${encodeURIComponent('Olá! Gostaria de agendar uma avaliação na Buzzi Odontologia.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl font-bold text-white bg-teal-600 hover:bg-teal-700 active:scale-95 transition-all shadow-lg shadow-teal-700/20 text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Conversar Agora pelo WhatsApp</span>
          </a>

          <p class="text-xs text-slate-500 mt-4">
            Atendimento rápido e humanizado em Curitiba • Fanny
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
