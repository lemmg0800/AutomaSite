---
import type { ClientConfig } from '../../schema';

interface TestimonialItem {
  quote: string;
  author: string;
  role?: string;
}

interface Props {
  content: {
    title: string;
    subtitle?: string;
    items: TestimonialItem[];
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section id="depoimentos" class="py-20 md:py-28 bg-slate-50/70 border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-teal-200 bg-white text-teal-800 shadow-sm mb-4">
        <span>⭐ 111 Avaliações 5 Estrelas no Google</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight font-['Playfair_Display',serif]">
        {content.title}
      </h2>
      <p class="text-base text-slate-600 mt-3 font-['Plus_Jakarta_Sans',sans-serif]">
        A satisfação e o conforto de quem confiou o sorriso à Dra. Fernanda Buzzi e equipe.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {content.items.map((t) => (
        <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="text-amber-400 text-lg mb-4">★★★★★</div>
            <p class="text-slate-700 italic leading-relaxed text-sm mb-6 font-['Plus_Jakarta_Sans',sans-serif]">
              "{t.quote}"
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center font-bold text-xs">
              {t.author.charAt(0)}
            </div>
            <div>
              <strong class="block text-sm font-semibold text-slate-900">{t.author}</strong>
              <span class="text-xs text-slate-500">{t.role || 'Paciente no Google'}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
