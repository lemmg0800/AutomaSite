---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    logoText?: string;
    description?: string;
    copyrightText?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-slate-200 py-12 text-slate-600 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-100">
      
      <!-- Coluna 1: Logo & Resumo -->
      <div class="md:col-span-2 space-y-4">
        <img 
          src="/clients/buzzi-odontologia/logo.png" 
          alt="Buzzi Odontologia" 
          class="h-10 w-auto object-contain"
        />
        <p class="text-xs text-slate-500 max-w-sm leading-relaxed">
          Buzzi Odontologia — Clínica odontológica especializada em Implantes, Ortodontia e Odontologia Estética com atendimento humanizado em Curitiba.
        </p>
        <p class="text-xs text-teal-800 font-semibold">
          Responsável Técnica: Dra. Fernanda Buzzi • CRO/PR 17042
        </p>
      </div>

      <!-- Coluna 2: Navegação -->
      <div class="space-y-3">
        <h5 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Navegação</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="#inicio" class="hover:text-teal-700 transition">Início</a></li>
          <li><a href="#sobre" class="hover:text-teal-700 transition">A Clínica</a></li>
          <li><a href="#tratamentos" class="hover:text-teal-700 transition">Tratamentos</a></li>
          <li><a href="#diferenciais" class="hover:text-teal-700 transition">Diferenciais</a></li>
          <li><a href="#depoimentos" class="hover:text-teal-700 transition">Avaliações Google</a></li>
          <li><a href="#contato" class="hover:text-teal-700 transition">Agendamento</a></li>
        </ul>
      </div>

      <!-- Coluna 3: Contato & Redes -->
      <div class="space-y-3">
        <h5 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Unidade Curitiba</h5>
        <p class="text-xs text-slate-500">
          Rua Maestro Francisco Antonello, 697<br/>
          Bairro Fanny • Curitiba - PR
        </p>
        <p class="text-xs text-teal-700 font-semibold">
          WhatsApp: (41) 99524-4522
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://instagram.com/buzziodonto" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:text-teal-700 hover:bg-teal-50 transition" title="Instagram">
            📸
          </a>
          <a href="https://facebook.com/odontobuzzirocha" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:text-teal-700 hover:bg-teal-50 transition" title="Facebook">
            📘
          </a>
          <a href="https://linkedin.com/company/buzzi-odontologia" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:text-teal-700 hover:bg-teal-50 transition" title="LinkedIn">
            💼
          </a>
        </div>
      </div>

    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {currentYear} Buzzi Odontologia. Todos os direitos reservados.</p>
      <p>Desenvolvido com excelência técnica e design system médico.</p>
    </div>
  </div>
</footer>
