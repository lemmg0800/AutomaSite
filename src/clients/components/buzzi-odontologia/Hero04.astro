---
import type { ClientConfig } from '../../schema';

interface Props {
  content: {
    tagline?: string;
    headline: string;
    subheadline?: string;
    primaryCta?: { text: string; href?: string };
    secondaryCta?: { text: string; href?: string };
    stats?: Array<{ value: string; label: string }>;
    image?: string;
    badgeText?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;

const phone = client?.business?.whatsapp || client?.business?.phone || '(41) 99524-4522';
const cleanPhone = phone.replace(/\D/g, '');
const defaultCtaLink = `https://wa.me/55${cleanPhone}?text=${encodeURIComponent('Olá! Vim pelo site da Buzzi Odontologia e gostaria de agendar uma avaliação.')}`;

const primaryText = content?.primaryCta?.text || "Agendar Avaliação no WhatsApp";
const primaryHref = content?.primaryCta?.href || defaultCtaLink;
const secondaryText = content?.secondaryCta?.text || "Ver Tratamentos & Especialidades";
const secondaryHref = content?.secondaryCta?.href || "#tratamentos";
const badgeText = content?.badgeText || content?.tagline || "⭐ Nota 5.0 no Google • 111 Avaliações Verificadas";
const heroImage = content?.image || "/clients/buzzi-odontologia/clinica.jpg";
---

<section id="inicio" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-slate-50/70 border-b border-slate-200/60">
  <!-- Subtle Medical Ambient Gradient -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-teal-500/10 blur-[130px] pointer-events-none rounded-full"></div>
  <div class="absolute -bottom-20 right-10 w-[400px] h-[400px] bg-emerald-500/5 blur-[100px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Coluna Esquerda: Mensagem Principal -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Badge de Confiança / Google Reviews -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide mb-6 border border-teal-200 bg-white/90 text-teal-800 shadow-sm backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          <span>{badgeText}</span>
        </div>

        <!-- Headline com tipografia Echelon/Playfair -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.12] mb-6 font-['Playfair_Display',serif]">
          Implantes, Ortodontia & Estética com <span class="text-teal-700 italic">Cuidado Humanizado</span>
        </h1>

        <!-- Subheadline com tom acolhedor -->
        <p class="text-lg sm:text-xl text-slate-600 font-normal leading-relaxed max-w-2xl mb-8 font-['Plus_Jakarta_Sans',sans-serif]">
          Recupere a segurança de sorrir e mastigar com tratamentos individualizados, tecnologia digital e o conforto que você e sua família merecem no bairro Fanny, Curitiba.
        </p>

        <!-- CTAs de Ação Imediata -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a 
            href={primaryHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-semibold text-white bg-teal-600 hover:bg-teal-700 active:scale-[0.98] transition-all duration-200 shadow-lg shadow-teal-700/20 flex items-center justify-center gap-3"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>{primaryText}</span>
          </a>

          <a 
            href={secondaryHref}
            class="w-full sm:w-auto px-6 py-4 rounded-xl text-base font-semibold text-slate-700 hover:text-teal-800 border border-slate-300 bg-white hover:bg-slate-50 transition-all duration-200 shadow-sm flex items-center justify-center gap-2"
          >
            <span>{secondaryText}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>

        <!-- 3 Métricas Rápidas -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-200/80 w-full">
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-teal-800 font-['Playfair_Display',serif]">111+</div>
            <div class="text-xs sm:text-sm text-slate-600">Avaliações 5★ Google</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-teal-800 font-['Playfair_Display',serif]">CRO/PR</div>
            <div class="text-xs sm:text-sm text-slate-600">17042 Certificado</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-teal-800 font-['Playfair_Display',serif]">100%</div>
            <div class="text-xs sm:text-sm text-slate-600">Cuidado Humanizado</div>
          </div>
        </div>

      </div>

      <!-- Coluna Direita: Foto Real da Clínica + Card Flutuante -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white bg-white">
          <img 
            src={heroImage} 
            alt="Clínica Buzzi Odontologia em Curitiba" 
            class="w-full h-[420px] sm:h-[480px] object-cover object-center transform hover:scale-105 transition-transform duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
          
          <!-- Selo no Canto da Foto -->
          <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-4 rounded-xl shadow-lg border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 shrink-0 font-bold">
              📍
            </div>
            <div>
              <p class="text-xs font-bold text-slate-900">Sede Própria em Curitiba</p>
              <p class="text-[11px] text-slate-600">Rua Maestro Francisco Antonello, 697 • Fanny</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
