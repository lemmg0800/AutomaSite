---
interface Props {
  content?: {
    badge?: string;
    title?: string;
    subtitle?: string;
  };
  clientSlug?: string;
  client?: any;
}

const { content } = Astro.props;

const badge = content?.badge || "Linha de Fabricação Própria";
const title = content?.title || "Catálogo de Produtos em Comunicação Visual";
const subtitle = content?.subtitle || "Desenvolvemos projetos sob medida para indústrias, comércio e serviços em Criciúma e Sul de SC.";

const products = [
  {
    title: "Totens Comerciais e Rodoviários",
    desc: "Estruturas metálicas autoportantes com fechamento em ACM, iluminação embutida e sapatas calculadas.",
    image: "/leads/prolume-comunicacao-visual/2849da31a7218cda_totem_9_capa.jpg",
    tag: "Estruturas Pesadas"
  },
  {
    title: "Painéis Back-light e Front-light",
    desc: "Caixas luminosas com difusor acrílico ou lona translúcida e módulos de LED com alta durabilidade.",
    image: "/leads/prolume-comunicacao-visual/c0294043d6ec51cd_back-light_3_capa.jpg",
    tag: "Visibilidade Noturna"
  },
  {
    title: "Placas em ACM e PVC Expandido",
    desc: "Placas de identificação predial, painéis decorativos de parede e placas de sinalização de segurança.",
    image: "/leads/prolume-comunicacao-visual/240b170cd58e0532_placas-em-acm-pvc_11_capa.jpg",
    tag: "Sinalização Durável"
  },
  {
    title: "Corte a Laser CNC & Peças Técnicas",
    desc: "Corte milimétrico em acrílico, MDF e metais finos para troféus, displays, gabaritos e letreiros finos.",
    image: "/leads/prolume-comunicacao-visual/acc04538cf63a822_corte-a-laser_18_capa.jpg",
    tag: "Precisão CNC"
  },
  {
    title: "Peças em Acrílico & Displays",
    desc: "Urnas, porta-folhetos, púlpitos e peças especiais moldadas para feiras, eventos e pontos de venda.",
    image: "/leads/prolume-comunicacao-visual/840a021864125e52_acrilicos_1_capa.jpg",
    tag: "Acrílico Nobre"
  },
  {
    title: "Adesivagem de Veículos & Plotagens",
    desc: "Padronização visual de veículos comerciais, furgões e pick-ups com vinil polimérico de alta performance.",
    image: "/leads/prolume-comunicacao-visual/7f74e42eeb1349b6_veiculos_capa.jpg",
    tag: "Frotas Comerciais"
  }
];
---

<section id="produtos" class="py-24 bg-[#0a1424] border-t border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-block px-4 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 font-bold text-xs uppercase tracking-wider">
        {badge}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {title}
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((prod) => (
        <div class="group bg-slate-900 border border-slate-800 hover:border-sky-500/50 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col hover:shadow-2xl hover:shadow-sky-950/40">
          <div class="relative h-60 overflow-hidden bg-slate-950">
            <img 
              src={prod.image} 
              alt={prod.title} 
              class="w-full h-full object-cover transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 rounded-md bg-sky-600 text-white font-bold text-xs uppercase shadow">
                {prod.tag}
              </span>
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="text-xl font-bold text-white group-hover:text-sky-400 transition-colors">
                {prod.title}
              </h3>
              <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                {prod.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800">
              <a 
                href="https://wa.me/5548984037906?text=Ol%C3%A1%2C%20quero%20um%20or%C3%A7amento%20para%20este%20produto!"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sky-400 hover:text-sky-300 font-bold text-sm"
              >
                <span>Pedir Cotação no WhatsApp</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
