---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const navLinks = content.navLinks || [
  { label: "Serviços", href: "#servicos" },
  { label: "Casos de Sucesso", href: "#diferenciais" },
  { label: "Sobre", href: "#sobre" }
];
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/\D/g, '');
const whatsLink = cleanWhats ? `https://wa.me/55${cleanWhats}` : '#contato';
---

<header class="sticky top-0 z-40 border-b border-white/10" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
    <a href={`/${client.status === 'published' ? client.slug : `preview/${client.slug}`}`} class="font-bold text-base text-white tracking-wide">
      {client.business.name}
    </a>

    <div class="p-1 rounded-full border border-white/10 bg-white/[0.03] hidden md:flex items-center gap-1">
      {navLinks.map((l, i) => (
        <a href={l.href} class={`px-4 py-1.5 rounded-full text-xs font-medium transition-colors ${i === 0 ? 'bg-white/10 text-white' : 'text-slate-400 hover:text-white'}`}>
          {l.label}
        </a>
      ))}
    </div>

    <a href={whatsLink} target="_blank" class="px-5 py-2 rounded-full font-bold text-xs uppercase tracking-wider" style="background-color: var(--color-accent); color: var(--color-bg);">
      {content?.ctaLabel || "Fale Conosco"}
    </a>
  </div>
</header>
