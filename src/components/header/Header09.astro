---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/\D/g, '');
const whatsLink = cleanWhats ? `https://wa.me/55${cleanWhats}` : '#contato';
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/70 backdrop-blur-2xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <a href={`/${client.status === 'published' ? client.slug : `preview/${client.slug}`}`} class="flex items-center gap-2">
      <span class="text-xs font-mono font-bold px-2 py-0.5 rounded border border-white/10" style="color: var(--color-accent);">PRO</span>
      <span class="font-bold text-sm text-white" style="font-family: var(--font-heading);">{client.business.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-xs font-medium text-slate-300">
      <a href="#servicos" class="hover:text-white transition-colors">Serviços</a>
      <a href="#diferenciais" class="hover:text-white transition-colors">Diferenciais</a>
      <a href="#sobre" class="hover:text-white transition-colors">Sobre Nós</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href={whatsLink} target="_blank" class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white border border-white/15 bg-white/5 hover:bg-white/10 transition-all">
        {content?.ctaLabel || "Fale Conosco"}
      </a>
    </div>
  </div>
</header>
