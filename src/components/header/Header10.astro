---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/\D/g, '');
const whatsLink = cleanWhats ? `https://wa.me/55${cleanWhats}` : '#contato';
---

<header class="w-full pt-8 pb-4 bg-transparent border-b border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between">
    <a href={`/${client.status === 'published' ? client.slug : `preview/${client.slug}`}`} class="text-sm font-mono tracking-widest uppercase text-white">
      // {client.business.name}
    </a>

    <div class="flex items-center gap-6">
      <span class="text-xs font-mono text-slate-500 hidden sm:inline">{client.business.city.toUpperCase()}</span>
      <a href={whatsLink} target="_blank" class="text-xs font-mono uppercase tracking-widest px-3 py-1.5 rounded border border-white/15 hover:border-white/40 transition-colors" style="color: var(--color-accent);">
        {content?.ctaLabel || "CONTATO"}
      </a>
    </div>
  </div>
</header>
