---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/\D/g, '');
const whatsLink = cleanWhats ? `https://wa.me/55${cleanWhats}` : '#contato';
---

<header class="sticky top-0 z-40 border-b border-white/10" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 grid grid-cols-3 items-center">
    <!-- Left Nav -->
    <nav class="hidden md:flex items-center gap-6 text-xs text-slate-300">
      <a href="#servicos" class="hover:text-white">Serviços</a>
      <a href="#sobre" class="hover:text-white">Sobre</a>
    </nav>

    <!-- Center Brand -->
    <div class="col-span-2 md:col-span-1 text-left md:text-center">
      <a href={`/${client.status === 'published' ? client.slug : `preview/${client.slug}`}`} class="text-lg font-bold tracking-tight text-white uppercase" style="font-family: var(--font-heading);">
        {client.business.name}
      </a>
    </div>

    <!-- Right CTA -->
    <div class="flex justify-end">
      <a href={whatsLink} target="_blank" class="px-5 py-2.5 rounded-full font-bold text-xs uppercase tracking-wider" style="background-color: var(--color-accent); color: var(--color-bg);">
        {content?.ctaLabel || "WhatsApp"}
      </a>
    </div>
  </div>
</header>
