---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    navLinks?: Array<{ label: string; href: string }>;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const navLinks = content.navLinks || [
  { label: "Serviços", href: "#servicos" },
  { label: "Diferenciais", href: "#diferenciais" },
  { label: "Sobre", href: "#sobre" }
];
const ctaLabel = content.ctaLabel || "Iniciar Projeto";
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/\D/g, '');
const whatsLink = cleanWhats ? `https://wa.me/55${cleanWhats}` : '#contato';
---

<header class="fixed top-6 left-0 right-0 z-50 px-4 sm:px-6 pointer-events-none">
  <div class="max-w-4xl mx-auto h-16 rounded-full border border-white/10 bg-slate-950/75 backdrop-blur-xl px-6 flex items-center justify-between shadow-2xl pointer-events-auto">
    <a href={`/${client.status === 'published' ? client.slug : `preview/${client.slug}`}`} class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full" style="background-color: var(--color-accent);"></span>
      <span class="font-bold text-sm text-white tracking-wide" style="font-family: var(--font-heading);">{client.business.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-xs text-slate-300 font-medium">
      {navLinks.map(l => (
        <a href={l.href} class="hover:text-white transition-colors">{l.label}</a>
      ))}
    </nav>

    <a href={whatsLink} target="_blank" class="px-4 py-2 rounded-full font-bold text-xs uppercase tracking-wider transition-all hover:scale-105" style="background-color: var(--color-accent); color: var(--color-bg);">
      {ctaLabel}
    </a>
  </div>
</header>
