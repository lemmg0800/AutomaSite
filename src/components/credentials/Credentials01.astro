---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title?: string;
    badges: Array<{ label: string; detail?: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-12 border-b border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    {content.title && <h3 class="text-xs font-bold uppercase tracking-widest text-center mb-6 opacity-75">{content.title}</h3>}
    <div class="flex flex-wrap justify-center gap-6 text-xs opacity-80">
      {content.badges.map(b => (
        <div class="flex items-center gap-2 px-4 py-2 rounded-lg border border-white/10" style="background-color: var(--color-secondary);">
          <span style="color: var(--color-accent);">✓</span>
          <strong>{b.label}</strong>
          {b.detail && <span class="opacity-70">({b.detail})</span>}
        </div>
      ))}
    </div>
  </div>
</section>