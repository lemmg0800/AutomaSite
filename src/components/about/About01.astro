---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    text1?: string;
    text2?: string;
    description?: string;
    highlights?: Array<{ number?: string; value?: string; label: string }>;
    stats?: Array<{ number?: string; value?: string; label: string }>;
    whyChoose?: string[];
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const mainText = content?.text1 || content?.description || '';
const subText = content?.text2 || '';
const highlightItems = content?.highlights || content?.stats || [];
const whyChooseItems = content?.whyChoose || [];
---

<section id="escritorio" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        {content?.badge && (
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border border-white/10" style="background-color: color-mix(in srgb, var(--color-accent) 15%, transparent); color: var(--color-accent);">
            {content.badge}
          </div>
        )}
        <h2 class="text-3xl sm:text-4xl font-bold leading-tight" style="font-family: var(--font-heading);">
          {content?.title}
        </h2>
        {mainText && (
          <p class="text-sm sm:text-base leading-relaxed opacity-85 font-light">
            {mainText}
          </p>
        )}
        {subText && (
          <p class="text-sm leading-relaxed opacity-75 font-light">
            {subText}
          </p>
        )}

        {highlightItems.length > 0 && (
          <div class="pt-2 flex flex-col sm:flex-row gap-6">
            {highlightItems.map(h => (
              <div class="border-l-2 pl-4 py-1" style="border-color: var(--color-accent);">
                <span class="block text-2xl font-bold" style="font-family: var(--font-heading);">{h.number || h.value}</span>
                <span class="text-xs opacity-75">{h.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {whyChooseItems.length > 0 && (
        <div class="lg:col-span-6">
          <div class="p-8 rounded-3xl border border-white/10 shadow-2xl" style="background-color: var(--color-secondary);">
            <h3 class="text-xl font-bold mb-6 flex items-center gap-2" style="font-family: var(--font-heading);">
              <span style="color: var(--color-accent);">⭐</span>
              <span>Diferenciais do Nosso Atendimento</span>
            </h3>

            <ul class="space-y-4 text-sm opacity-90">
              {whyChooseItems.map((item, idx) => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5" style="background-color: var(--color-accent); color: var(--color-bg);">
                    {idx + 1}
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>
</section>