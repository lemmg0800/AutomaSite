---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title: string;
    items: Array<{ label?: string; placeholderColor?: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-20 border-y border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-center mb-12" style="font-family: var(--font-heading);">{content.title}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {content.items.map((item, idx) => (
        <div class="aspect-video rounded-xl border border-white/10 flex items-center justify-center p-4 text-xs text-center opacity-75" style="background-color: var(--color-secondary);">
          {item.label || `Foto ${idx + 1}`}
        </div>
      ))}
    </div>
  </div>
</section>