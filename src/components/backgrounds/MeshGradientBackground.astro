---
interface Props {
  opacity?: number;
  blur?: string;
}

const { opacity = 0.5, blur = "120px" } = Astro.props;
---

<div class="mesh-background pointer-events-none fixed inset-0 overflow-hidden -z-10 select-none">
  <!-- Glow Orb 1 (Top Left) -->
  <div 
    class="mesh-orb orb-1 absolute -top-[15%] -left-[10%] w-[50vw] h-[50vw] rounded-full"
    style={`background: radial-gradient(circle, var(--color-accent, #6366f1) 0%, transparent 70%); opacity: ${opacity}; filter: blur(${blur});`}
  ></div>

  <!-- Glow Orb 2 (Top Right) -->
  <div 
    class="mesh-orb orb-2 absolute top-[20%] -right-[15%] w-[45vw] h-[45vw] rounded-full"
    style={`background: radial-gradient(circle, var(--color-secondary, #3b82f6) 0%, transparent 70%); opacity: ${opacity * 0.75}; filter: blur(${blur});`}
  ></div>

  <!-- Glow Orb 3 (Bottom Center) -->
  <div 
    class="mesh-orb orb-3 absolute -bottom-[10%] left-[25%] w-[40vw] h-[40vw] rounded-full"
    style={`background: radial-gradient(circle, var(--color-primary, #4338ca) 0%, transparent 70%); opacity: ${opacity * 0.6}; filter: blur(${blur});`}
  ></div>

  <!-- Noise Texture Overlay -->
  <div class="noise-overlay absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(rgba(255,255,255,0.4) 1px, transparent 0); background-size: 24px 24px;"></div>
</div>

<style>
  .mesh-orb {
    animation: meshFloat 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  .orb-1 {
    animation-duration: 22s;
  }

  .orb-2 {
    animation-duration: 16s;
    animation-delay: -5s;
  }

  .orb-3 {
    animation-duration: 20s;
    animation-delay: -10s;
  }

  @keyframes meshFloat {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(40px, -30px) scale(1.08);
    }
    100% {
      transform: translate(-30px, 40px) scale(0.95);
    }
  }
</style>
