---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    headline: string;
    subheadline?: string;
    buttonLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cleanWhats = (client.business.whatsapp || client.business.phone || '').replace(/[^0-9]/g, '');
const whatsLink = `https://wa.me/55${cleanWhats}?text=Ol%C3%A1!`;
---

<section class="py-20 text-center border-t border-white/10" style="background-color: var(--color-secondary);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">{content.headline}</h2>
    {content.subheadline && <p class="text-sm sm:text-base opacity-80 mb-8 max-w-xl mx-auto font-light">{content.subheadline}</p>}
    {cleanWhats && (
      <a href={whatsLink} target="_blank" class="inline-block px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-wider shadow-xl transition-all hover:scale-105" style="background-color: var(--color-accent); color: var(--color-bg);">
        {content.buttonLabel || "Falar com Especialista"}
      </a>
    )}
  </div>
</section>