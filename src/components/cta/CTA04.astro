---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    statsHighlight?: { value: string; label: string };
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const rawPhone = client?.business?.whatsapp || client?.business?.phone || '';
const cleanPhone = rawPhone.replace(/\D/g, '');
const defaultCta = cleanPhone ? `https://wa.me/55${cleanPhone}` : '#contato';
---

<section class="py-24 border-y border-white/5 relative overflow-hidden" style="background-color: var(--color-bg);">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[500px] h-[300px] rounded-full blur-[140px] opacity-20" style="background-color: var(--color-accent);"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
    {content?.statsHighlight && (
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8">
        <span class="font-mono font-bold text-base" style="color: var(--color-accent);">{content.statsHighlight.value}</span>
        <span class="text-xs text-slate-300">{content.statsHighlight.label}</span>
      </div>
    )}

    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight" style="font-family: var(--font-heading);">
      {content?.headline || "Transforme sua visão em arquitetura real"}
    </h2>

    <p class="text-base sm:text-lg text-slate-300 font-light max-w-xl mx-auto mb-10">
      {content?.subheadline || `Consulte nossa disponibilidade técnica para obras em ${client.business.city}.`}
    </p>

    <a 
      href={content?.primaryCtaHref || defaultCta}
      target="_blank"
      class="inline-block px-10 py-4 rounded-xl font-bold text-sm uppercase tracking-widest transition-all hover:scale-105 shadow-2xl"
      style="background-color: var(--color-accent); color: var(--color-bg);"
    >
      {content?.primaryCtaLabel || "Iniciar Conversa no WhatsApp"}
    </a>
  </div>
</section>
