---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const rawPhone = client?.business?.whatsapp || client?.business?.phone || '';
const cleanPhone = rawPhone.replace(/\D/g, '');
const defaultCta = cleanPhone ? `https://wa.me/55${cleanPhone}` : '#contato';
---

<section class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="p-10 sm:p-16 rounded-3xl border border-white/10 relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-8" style="background-color: var(--color-secondary);">
      <div class="max-w-xl">
        {content?.badge && (
          <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
            {content.badge}
          </span>
        )}
        <h2 class="text-2xl sm:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">
          {content?.headline || "Inicie seu Diagnóstico Técnico"}
        </h2>
        <p class="text-sm text-slate-300 font-light leading-relaxed">
          {content?.subheadline || "Converse com nossos especialistas e receba um plano de viabilidade estruturado para o seu imóvel."}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 shrink-0">
        <a 
          href={content?.primaryCtaHref || defaultCta}
          target="_blank"
          class="px-8 py-4 rounded-xl font-bold text-xs uppercase tracking-wider text-center transition-all hover:scale-105"
          style="background-color: var(--color-accent); color: var(--color-bg);"
        >
          {content?.primaryCtaLabel || "Agendar Diagnóstico"}
        </a>
        {content?.secondaryCtaLabel && (
          <a 
            href={content?.secondaryCtaHref || "#contato"}
            class="px-6 py-4 rounded-xl border border-white/15 hover:border-white/30 text-xs font-medium text-center text-white transition-all bg-white/[0.03]"
          >
            {content.secondaryCtaLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
