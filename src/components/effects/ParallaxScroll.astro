---
interface Props {
  revealSelector?: string;
  enable3DTilt?: boolean;
}

const { 
  revealSelector = ".reveal, .bento-card, .service-card, .benefit-card",
  enable3DTilt = true
} = Astro.props;
---

<script is:inline define:vars={{ revealSelector, enable3DTilt }}>
  (() => {
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Intersection Observer Scroll-Reveal
      const targets = document.querySelectorAll(revealSelector);
      
      targets.forEach((el) => {
        el.style.opacity = "0";
        el.style.transform = "translateY(22px)";
        el.style.transition = "opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1)";
        el.style.willChange = "opacity, transform";
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.style.opacity = "1";
              entry.target.style.transform = "translateY(0)";
              entry.target.style.willChange = "auto";
            }, (idx % 4) * 80);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      targets.forEach((el) => observer.observe(el));

      // 2. 3D Tilt & Parallax effect on mouse move
      if (enable3DTilt && window.matchMedia('(pointer: fine)').matches) {
        const tiltCards = document.querySelectorAll('.tilt-card, .floating-panel');

        tiltCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            const tiltX = (y / (rect.height / 2)) * -8;
            const tiltY = (x / (rect.width / 2)) * 8;

            card.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) translateY(-4px)`;
            card.style.transition = "transform 100ms ease-out";
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)";
            card.style.transition = "transform 400ms cubic-bezier(0.16, 1, 0.3, 1)";
          });
        });
      }
    });
  })();
</script>
