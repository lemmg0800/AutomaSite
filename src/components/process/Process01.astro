---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title: string;
    steps: Array<{ step: string; title: string; description: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-center mb-14" style="font-family: var(--font-heading);">{content.title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      {content.steps.map((s, idx) => (
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-full mx-auto flex items-center justify-center font-bold text-base shadow-lg" style="background-color: var(--color-accent); color: var(--color-bg);">
            {idx + 1}
          </div>
          <h3 class="font-bold text-lg">{s.title}</h3>
          <p class="text-xs opacity-75">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>