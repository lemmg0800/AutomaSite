---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    steps: Array<{
      number?: string;
      title: string;
      description: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const steps = content?.steps || (content as any)?.items || [];
---

<section class="py-24 border-y border-white/5" style="background-color: color-mix(in srgb, var(--color-secondary) 25%, transparent);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-3" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Etapas da Jornada"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
      {steps.map((s, idx) => (
        <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] relative">
          <div class="text-3xl font-extrabold font-mono mb-4" style="color: var(--color-accent);">
            {s.number || `0${idx + 1}`}
          </div>
          <h3 class="text-base font-bold text-white mb-2" style="font-family: var(--font-heading);">
            {s.title}
          </h3>
          <p class="text-xs text-slate-300 font-light leading-relaxed">
            {s.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
