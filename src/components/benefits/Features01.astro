---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      icon?: string;
      link?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || (content as any)?.features || [];
---

<section class="py-24 border-y border-white/5" style="background-color: color-mix(in srgb, var(--color-secondary) 15%, transparent);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-bold uppercase tracking-widest block mb-3" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4xl font-bold" style="font-family: var(--font-heading);">
        {content.title || (content as any)?.headline || "Soluções e Pilares"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map(item => (
        <div class="p-8 rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl bg-white/[0.02] flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-6 border border-white/10" style="background-color: var(--color-secondary); color: var(--color-accent);">
              {item.icon || "✦"}
            </div>
            <h3 class="text-lg font-bold text-white mb-3" style="font-family: var(--font-heading);">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
