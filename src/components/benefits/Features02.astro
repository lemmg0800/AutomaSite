---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      tag?: string;
      icon?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || (content as any)?.features || [];
---

<section class="py-24 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-xl mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Diferenciais Técnicos"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-4">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item, idx) => (
        <div class="p-8 rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 relative overflow-hidden" style="background-color: var(--color-secondary);">
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-xs text-slate-500">0{idx + 1}</span>
            {item.tag && (
              <span class="text-[10px] uppercase font-mono tracking-wider px-2.5 py-1 rounded-full border border-white/10 bg-white/5" style="color: var(--color-accent);">
                {item.tag}
              </span>
            )}
          </div>
          <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-heading);">
            {item.title}
          </h3>
          <p class="text-sm text-slate-300 font-light leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
