---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title: string;
    subtitle?: string;
    items: Array<{ title: string; description: string; icon?: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-20" style="background-color: color-mix(in srgb, var(--color-secondary) 25%, transparent);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-bold" style="font-family: var(--font-heading);">{content.title}</h2>
      {content.subtitle && <p class="text-sm mt-3 opacity-75">{content.subtitle}</p>}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {(content.items || content.benefits || []).map((b: any) => (
        <div class="p-6 rounded-xl border border-white/10" style="background-color: var(--color-secondary);">
          <div class="text-2xl mb-3">{b.icon || "⭐"}</div>
          <h3 class="font-bold text-base mb-2">{b.title}</h3>
          <p class="text-xs opacity-75 leading-relaxed">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>