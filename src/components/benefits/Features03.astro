---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      icon?: string;
      actionText?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || (content as any)?.features || [];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-bold uppercase tracking-widest block mb-3" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Pilares Estratégicos"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map(item => (
        <div class="p-8 rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 relative group overflow-hidden bg-white/[0.02]">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-inner border border-white/10" style="background-color: var(--color-secondary); color: var(--color-accent);">
            {item.icon || "✓"}
          </div>
          <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-heading);">
            {item.title}
          </h3>
          <p class="text-sm text-slate-300 font-light leading-relaxed mb-6">
            {item.description}
          </p>
          {item.actionText && (
            <div class="text-xs font-bold uppercase tracking-wider flex items-center gap-1 group-hover:gap-2 transition-all" style="color: var(--color-accent);">
              <span>{item.actionText}</span>
              <span>&rarr;</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
