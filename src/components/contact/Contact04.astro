---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    departments?: Array<{
      name: string;
      email: string;
      phone: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const depts = content?.departments || [
  { name: "Projetos Residenciais", email: client.business.email || `contato@${client.slug}.com.br`, phone: client.business.phone || "(41) 3000-0000" },
  { name: "Corporativo & Comercial", email: client.business.email || `contato@${client.slug}.com.br`, phone: client.business.phone || "(41) 3000-0000" },
  { name: "Assessoria de Imprensa", email: `imprensa@${client.slug}.com.br`, phone: client.business.phone || "(41) 3000-0000" }
];
---

<section id="contato" class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Canais Dedicados"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {depts.map((d, idx) => (
        <div class="p-8 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-6">CANAL 0{idx + 1}</div>
            <h3 class="text-xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
              {d.name}
            </h3>
            <div class="space-y-2 text-xs sm:text-sm text-slate-300">
              <div class="flex items-center gap-2">
                <span>✉</span>
                <a href={`mailto:${d.email}`} class="hover:underline">{d.email}</a>
              </div>
              <div class="flex items-center gap-2">
                <span>📞</span>
                <a href={`tel:${d.phone.replace(/\D/g, '')}`} class="hover:underline">{d.phone}</a>
              </div>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-white/5 text-[10px] font-mono text-slate-400">
            RESPOSTA EM ATÉ 24H ÚTEIS
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
