---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section id="contato" class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    {content.badge && (
      <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
        {content.badge}
      </span>
    )}
    <h2 class="text-3xl sm:text-5xl font-bold mb-4" style="font-family: var(--font-heading);">
      {content.title || "Agende uma Consulta"}
    </h2>
    <p class="text-sm sm:text-base text-slate-300 font-light mb-12">
      {content.subtitle || "Preencha os campos abaixo e nosso time sênior responderá em até 2 horas úteis."}
    </p>

    <form onsubmit="event.preventDefault(); alert('Mensagem enviada com sucesso!');" class="p-8 sm:p-12 rounded-3xl border border-white/10 bg-white/[0.02] text-left space-y-5 shadow-2xl">
      <div>
        <label class="block text-xs font-mono uppercase tracking-wider mb-2 text-slate-300">Seu Nome</label>
        <input type="text" required placeholder="Como prefere ser chamado?" class="w-full px-4 py-3 rounded-xl border border-white/10 bg-white/5 text-sm text-white focus:outline-none focus:ring-1" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-mono uppercase tracking-wider mb-2 text-slate-300">E-mail</label>
          <input type="email" required placeholder="seu@email.com" class="w-full px-4 py-3 rounded-xl border border-white/10 bg-white/5 text-sm text-white focus:outline-none focus:ring-1" />
        </div>
        <div>
          <label class="block text-xs font-mono uppercase tracking-wider mb-2 text-slate-300">Telefone / Celular</label>
          <input type="tel" required placeholder="(00) 00000-0000" class="w-full px-4 py-3 rounded-xl border border-white/10 bg-white/5 text-sm text-white focus:outline-none focus:ring-1" />
        </div>
      </div>
      <div>
        <label class="block text-xs font-mono uppercase tracking-wider mb-2 text-slate-300">Mensagem ou Dúvida</label>
        <textarea rows="3" placeholder="Como podemos auxiliar seu objetivo hoje?" class="w-full px-4 py-3 rounded-xl border border-white/10 bg-white/5 text-sm text-white focus:outline-none focus:ring-1"></textarea>
      </div>
      <button type="submit" class="w-full py-4 rounded-xl font-bold text-xs uppercase tracking-widest transition-all hover:scale-[1.01]" style="background-color: var(--color-accent); color: var(--color-bg);">
        Confirmar Envio
      </button>
    </form>
  </div>
</section>
