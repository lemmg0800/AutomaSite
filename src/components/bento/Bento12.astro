---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    featureCategories: Array<{
      title: string;
      items: string[];
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const categories = content?.featureCategories || [
  {
    title: "Engenharia & Estrutura",
    items: ["Cálculo estrutural avançado", "Compatibilização hidráulica/elétrica", "Supervisão técnica de fundações", "Laudos e vistorias periciais"]
  },
  {
    title: "Conforto & Arquitetura",
    items: ["Estudo bioclimático e insolação", "Isolamento termoacústico de alto nível", "Fluxos de circulação inteligentes", "Iluminação cenográfica integrada"]
  },
  {
    title: "Acabamentos & Interiores",
    items: ["Curadoria de pedras naturais e madeiras nobres", "Marcenaria milimétrica sob medida", "Metais e louças de design assinado", "Automação residencial completa"]
  }
];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Detalhamento Técnico"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {categories.map((cat, idx) => (
        <div class="p-8 sm:p-10 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all flex flex-col justify-between" style={idx === 0 ? "background-color: color-mix(in srgb, var(--color-secondary) 25%, transparent);" : ""}>
          <div>
            <div class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-6">MÓDULO 0{idx + 1}</div>
            <h3 class="text-xl font-bold text-white mb-6" style="font-family: var(--font-heading);">
              {cat.title}
            </h3>
            <ul class="space-y-3.5">
              {cat.items.map(item => (
                <li class="flex items-center gap-3 text-xs sm:text-sm text-slate-300 font-light">
                  <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-accent);"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-10 pt-6 border-t border-white/5 text-[10px] font-mono text-slate-400">
            PADRÃO DE ENTREGA // {client.business.city.toUpperCase()}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
