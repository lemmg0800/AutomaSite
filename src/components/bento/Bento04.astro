---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    cards: Array<{
      title: string;
      description: string;
      icon?: string;
      metric?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cards = content?.cards || [
  { title: "Atendimento Consultivo", description: "Comunicação contínua e estratégica.", metric: "100%", icon: "💬" },
  { title: "Qualidade Arquitetônica", description: "Design autoral premiado e reconhecido.", metric: "99.8%", icon: "🏛️" },
  { title: "Segurança Contratual", description: "Conformidade legal e transparência.", metric: "ISO", icon: "🛡️" },
  { title: "Prazos Rigorosos", description: "Gestão técnica de cronograma.", metric: "0 atrasos", icon: "⏱️" }
];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-xl mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Pilares de Segurança"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {cards.map(c => (
        <div class="p-8 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4">{c.icon || "✦"}</div>
            <h3 class="text-lg font-bold text-white mb-2" style="font-family: var(--font-heading);">
              {c.title}
            </h3>
            <p class="text-xs text-slate-300 font-light leading-relaxed mb-6">
              {c.description}
            </p>
          </div>
          {c.metric && (
            <div class="text-xl font-bold font-mono pt-4 border-t border-white/5" style="color: var(--color-accent);">
              {c.metric}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
