---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    primaryCard: {
      title: string;
      description: string;
      tag?: string;
    };
    secondaryCards: Array<{
      title: string;
      description: string;
      metric?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const primary = content?.primaryCard || {
  title: "Engenharia & Solidez",
  description: "Estrutura dedicada para projetos de alta complexidade com acompanhamento em tempo real.",
  tag: "NÚCLEO PRINCIPAL"
};
const secondaries = content?.secondaryCards || [
  { title: "Atendimento Dedicado", description: "Comunicação direta sem intermediários.", metric: "100%" },
  { title: "Satisfação Garantida", description: "Compromisso integral com cronogramas e entregas.", metric: "99.4%" }
];
---

<section class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Estrutura Integrada"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Big Hero Card -->
      <div class="md:col-span-8 p-8 sm:p-12 rounded-3xl border border-white/10 relative overflow-hidden flex flex-col justify-between" style="background-color: var(--color-secondary);">
        <div>
          {primary.tag && (
            <span class="text-[10px] font-mono tracking-widest uppercase px-3 py-1 rounded-full border border-white/10 bg-white/5 inline-block mb-6" style="color: var(--color-accent);">
              {primary.tag}
            </span>
          )}
          <h3 class="text-2xl sm:text-4xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
            {primary.title}
          </h3>
          <p class="text-base text-slate-300 font-light leading-relaxed max-w-xl">
            {primary.description}
          </p>
        </div>
        <div class="mt-12 text-xs font-mono text-slate-400">
          PADRÃO DE REFERÊNCIA EM {client.business.city.toUpperCase()}
        </div>
      </div>

      <!-- Side Cards -->
      <div class="md:col-span-4 flex flex-col gap-6">
        {secondaries.map(sec => (
          <div class="p-8 rounded-3xl border border-white/10 bg-white/[0.02] flex-1 flex flex-col justify-between hover:border-white/20 transition-all">
            <div>
              {sec.metric && (
                <div class="text-3xl font-extrabold font-mono mb-3" style="color: var(--color-accent);">
                  {sec.metric}
                </div>
              )}
              <h4 class="text-lg font-bold text-white mb-2" style="font-family: var(--font-heading);">
                {sec.title}
              </h4>
              <p class="text-xs text-slate-300 font-light leading-relaxed">
                {sec.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
