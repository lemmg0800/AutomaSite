---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      metric?: string;
      tag?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || [
  { title: "Índice de Fidelização", description: "Clientes que retornam para novos projetos residenciais e corporativos.", metric: "92%", tag: "CONFIANÇA" },
  { title: "Metragem Entregue", description: "Área total projetada e executada com precisão técnica.", metric: "+45.000m²", tag: "VOLUME" },
  { title: "Conformidade e Aprovação", description: "Projetos aprovados nos órgãos competentes sem retrabalho.", metric: "100%", tag: "AGILIDADE" }
];
---

<section class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Indicadores Estratégicos"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map(item => (
        <div class="p-8 sm:p-10 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all flex flex-col justify-between">
          <div>
            {item.tag && (
              <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full border border-white/10 bg-white/5 inline-block mb-6" style="color: var(--color-accent);">
                {item.tag}
              </span>
            )}
            {item.metric && (
              <div class="text-4xl sm:text-5xl font-extrabold font-mono mb-4 text-white">
                {item.metric}
              </div>
            )}
            <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-heading);">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5 text-[10px] font-mono text-slate-500">
            DADOS COMPROVADOS // {client.business.city.toUpperCase()}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
