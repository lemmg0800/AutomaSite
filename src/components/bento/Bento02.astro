---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      colSpan?: number; // 1 ou 2
      icon?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || [
  { title: "Arquitetura Conceitual", description: "Projetos autorais focados em atemporalidade, conforto ambiental e proporções harmoniosas.", colSpan: 2, icon: "🏛️" },
  { title: "Execução & Gestão", description: "Acompanhamento minucioso de cronograma com relatórios detalhados.", colSpan: 1, icon: "📊" },
  { title: "Tecnologia BIM", description: "Compatibilização completa para evitar retrabalho e desperdício financeiro.", colSpan: 1, icon: "💻" },
  { title: "Curadoria de Materiais", description: "Seleção rigorosa de acabamentos nobres com fornecedores certificados.", colSpan: 2, icon: "✨" }
];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Mosaico de Competências"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {items.map((item, idx) => (
        <div class={`p-8 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all duration-300 flex flex-col justify-between group ${item.colSpan === 2 ? 'md:col-span-2' : 'md:col-span-1'}`} style={idx === 0 ? "background-color: color-mix(in srgb, var(--color-secondary) 40%, transparent);" : ""}>
          <div>
            <div class="text-2xl mb-6">{item.icon || "✦"}</div>
            <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-heading);">
              {item.title}
            </h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/5 text-[10px] font-mono text-slate-500 uppercase tracking-widest">
            {client.business.name} // 0{idx + 1}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
