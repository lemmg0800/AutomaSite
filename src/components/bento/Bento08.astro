---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      badge?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || [
  { title: "Precisão Conceitual", description: "Projetos desenvolvidos sob rigorosas normas ergonômicas e estéticas.", badge: "NORMA TÉCNICA" },
  { title: "Supervisão Contínua", description: "Acompanhamento presencial em todas as fases críticas da edificação.", badge: "CAMPO" },
  { title: "Transparência Orçamentária", description: "Controle estrito de planilhas para eliminar surpresas financeiras.", badge: "GESTÃO" },
  { title: "Pós-Entrega Assistido", description: "Suporte dedicado para validação de sistemas e garantias construtivas.", badge: "GARANTIA" }
];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Pilares de Excelência"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item, idx) => (
        <div class="p-8 sm:p-10 rounded-3xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all flex flex-col justify-between" style={idx === 0 ? "background-color: color-mix(in srgb, var(--color-secondary) 30%, transparent);" : ""}>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-mono text-slate-500">DIRETRIZ 0{idx + 1}</span>
              {item.badge && (
                <span class="text-[10px] font-mono uppercase px-2.5 py-1 rounded-full border border-white/10 bg-white/5" style="color: var(--color-accent);">
                  {item.badge}
                </span>
              )}
            </div>
            <h3 class="text-2xl font-bold text-white mb-3" style="font-family: var(--font-heading);">
              {item.title}
            </h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5 text-[10px] font-mono text-slate-400">
            PADRÃO EXECUTIVO // {client.business.name.toUpperCase()}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
