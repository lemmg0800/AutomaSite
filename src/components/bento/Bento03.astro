---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    items: Array<{
      title: string;
      description: string;
      tag?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || [
  { title: "Diagnóstico Inicial", description: "Mapeamento aprofundado dos requisitos e viabilidade do investimento.", tag: "FASE 1" },
  { title: "Projeto Executivo", description: "Detalhamento milimétrico com especificações completas de engenharia.", tag: "FASE 2" },
  { title: "Acompanhamento Técnico", description: "Supervisão in loco garantindo fidelidade absoluta ao projeto concebido.", tag: "FASE 3" }
];
---

<section class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Tríade de Entrega"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map((item, idx) => (
        <div class="p-8 sm:p-10 rounded-3xl border border-white/10 relative overflow-hidden flex flex-col justify-between hover:border-white/20 transition-all" style="background-color: var(--color-secondary);">
          <div>
            <div class="flex items-center justify-between mb-8">
              <span class="text-xs font-mono text-slate-500">0{idx + 1}</span>
              {item.tag && (
                <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full border border-white/10 bg-white/5" style="color: var(--color-accent);">
                  {item.tag}
                </span>
              )}
            </div>
            <h3 class="text-2xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
              {item.title}
            </h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-10 pt-6 border-t border-white/10 flex items-center justify-between text-xs font-mono text-slate-400">
            <span>{client.business.city}</span>
            <span style="color: var(--color-accent);">✦</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
