---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    centralFocus: {
      title: string;
      description: string;
      tag?: string;
    };
    pillars: Array<{
      title: string;
      description: string;
      icon?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const central = content?.centralFocus || {
  title: "Atuação Consultiva Integral",
  description: "Da concepção conceitual à entrega das chaves, coordenamos todas as engrenagens técnicas e estéticas com excelência.",
  tag: "NÚCLEO CENTRAL"
};
const pillars = content?.pillars || [
  { title: "Gestão Integrada", description: "Compatibilização de complementares sem conflitos.", icon: "⚙️" },
  { title: "Detalhamento BIM", description: "Modelagem paramétrica precisa em 3D.", icon: "📐" },
  { title: "Curadoria Fina", description: "Seleção harmoniosa de iluminação e texturas.", icon: "🎨" },
  { title: "Acompanhamento Técnico", description: "Presença ativa nos momentos mais cruciais.", icon: "🛡️" }
];
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
        {content.title || "Ecossistema de Soluções"}
      </h2>
      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-300 font-light mt-3">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Centro Principal -->
      <div class="lg:col-span-6 p-10 sm:p-14 rounded-3xl border border-white/10 relative overflow-hidden" style="background-color: var(--color-secondary);">
        <span class="text-[10px] font-mono uppercase tracking-widest px-3 py-1 rounded-full border border-white/10 bg-white/5 inline-block mb-6" style="color: var(--color-accent);">
          {central.tag || "NÚCLEO CENTRAL"}
        </span>
        <h3 class="text-2xl sm:text-4xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
          {central.title}
        </h3>
        <p class="text-sm sm:text-base text-slate-300 font-light leading-relaxed mb-8">
          {central.description}
        </p>
        <div class="text-xs font-mono text-slate-400">
          SERVIÇO EXCLUSIVO // {client.business.name.toUpperCase()}
        </div>
      </div>

      <!-- Pilares Laterais 2x2 -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {pillars.map(p => (
          <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02] hover:border-white/20 transition-all">
            <div class="text-2xl mb-3">{p.icon || "✦"}</div>
            <h4 class="text-base font-bold text-white mb-2" style="font-family: var(--font-heading);">
              {p.title}
            </h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed">
              {p.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
