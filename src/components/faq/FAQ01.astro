---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title: string;
    subtitle?: string;
    questions: Array<{ q: string; a: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold" style="font-family: var(--font-heading);">{content.title}</h2>
      {content.subtitle && <p class="text-sm opacity-75 mt-2">{content.subtitle}</p>}
    </div>
    <div class="space-y-4">
      {content.questions.map(item => (
        <details class="p-6 rounded-xl border border-white/10 cursor-pointer group" style="background-color: var(--color-secondary);">
          <summary class="font-bold text-sm flex justify-between items-center select-none">
            <span>{item.q}</span>
            <span class="text-lg transition-transform group-open:rotate-45" style="color: var(--color-accent);">+</span>
          </summary>
          <p class="text-xs opacity-80 mt-4 leading-relaxed pl-1">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>