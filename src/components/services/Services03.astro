---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    tagline?: string;
    title: string;
    description?: string;
    items: Array<{
      title: string;
      description: string;
      badge?: string;
      icon?: string;
      featured?: boolean;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const items = content?.items || [];
---

<section id="servicos" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      {content?.tagline && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase mb-4 border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
          {content.tagline}
        </span>
      )}
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        {content.title}
      </h2>
      {content?.description && (
        <p class="text-base sm:text-lg text-slate-400">
          {content.description}
        </p>
      )}
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {items.map((item, index) => {
        const isFeatured = item.featured || index === 0;
        return (
          <div class={`bento-card tilt-card group relative p-8 rounded-2xl bg-slate-900/50 border border-white/10 hover:border-[var(--color-accent)]/50 transition-all duration-300 backdrop-blur-sm flex flex-col justify-between ${isFeatured ? 'md:col-span-2 bg-gradient-to-br from-slate-900/80 to-slate-950/80 border-white/15' : ''}`}>
            <!-- Ambient Hover Glow -->
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between mb-6">
                {item.badge && (
                  <span class="text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-slate-300">
                    {item.badge}
                  </span>
                )}
                <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center font-bold text-base group-hover:scale-110 transition-transform duration-300">
                  {item.icon || '→'}
                </div>
              </div>

              <h3 class={`font-bold text-white mb-3 group-hover:text-[var(--color-accent)] transition-colors ${isFeatured ? 'text-2xl' : 'text-xl'}`}>
                {item.title}
              </h3>

              <p class="text-sm text-slate-400 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-semibold text-[var(--color-accent)] gap-1 group-hover:gap-2 transition-all">
              <span>Saiba mais</span>
              <span>→</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
