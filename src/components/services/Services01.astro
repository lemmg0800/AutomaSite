---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    services: Array<{
      icon?: string;
      title: string;
      description: string;
      cta?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const cleanWhats = (client.business.whatsapp || client.business.phone).replace(/[^0-9]/g, '');
---

<section id="especialidades" class="py-20 border-y border-white/5" style="background-color: color-mix(in srgb, var(--color-secondary) 40%, transparent);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {content.badge && (
        <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent);">
          {content.badge}
        </span>
      )}
      <h2 class="text-3xl sm:text-4xl font-bold mt-2" style="font-family: var(--font-heading);">
        {content.title}
      </h2>
      {content.subtitle && (
        <p class="text-sm mt-3 opacity-75 font-light">
          {content.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {content.services.map(s => {
        const link = `https://wa.me/55${cleanWhats}?text=${encodeURIComponent(`Olá! Gostaria de informações sobre ${s.title}.`)}`;
        return (
          <div class="p-7 rounded-2xl border border-white/10 hover:border-white/20 transition-all hover:-translate-y-1 hover:shadow-xl group" style="background-color: var(--color-secondary);">
            {s.icon && (
              <div class="w-12 h-12 rounded-xl flex items-center justify-center font-bold text-xl mb-5" style="background-color: color-mix(in srgb, var(--color-accent) 20%, transparent); color: var(--color-accent);">
                {s.icon}
              </div>
            )}
            <h3 class="text-xl font-bold mb-2.5" style="font-family: var(--font-heading);">
              {s.title}
            </h3>
            <p class="text-sm leading-relaxed mb-6 opacity-80 font-light">
              {s.description}
            </p>
            {s.cta && (
              <a 
                href={link} 
                target="_blank"
                class="text-xs font-bold flex items-center gap-1.5 transition-all group-hover:translate-x-1"
                style="color: var(--color-accent);"
              >
                <span>{s.cta}</span>
                <span>&rarr;</span>
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>