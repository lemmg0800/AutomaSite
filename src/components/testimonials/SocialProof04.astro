---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    quote: string;
    author: string;
    role: string;
    company?: string;
    metricLabel?: string;
    metricValue?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="p-10 sm:p-16 rounded-3xl border border-white/10 relative overflow-hidden" style="background-color: color-mix(in srgb, var(--color-secondary) 40%, transparent);">
      <div class="max-w-3xl">
        <div class="flex items-center gap-1 text-amber-400 text-lg mb-6">
          ★★★★★
        </div>
        <blockquote class="text-xl sm:text-3xl font-light text-white leading-relaxed mb-10" style="font-family: var(--font-heading);">
          "{content?.quote || `A seriedade e o talento técnico de ${client.business.name} transformaram completamente nossa percepção sobre obras e prazos.`}"
        </blockquote>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-8 border-t border-white/10">
          <div>
            <div class="text-base font-bold text-white">{content?.author || "Marcelo Vianna"}</div>
            <div class="text-xs text-slate-400">{content?.role || "CEO & Fundador"} {content?.company ? `// ${content.company}` : ''}</div>
          </div>
          {content?.metricValue && (
            <div class="text-left sm:text-right">
              <div class="text-2xl font-mono font-bold" style="color: var(--color-accent);">{content.metricValue}</div>
              <div class="text-xs text-slate-400">{content.metricLabel || "Resultado Mensurável"}</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
