---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    works: Array<{
      title: string;
      year: string;
      location: string;
      category: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const works = content?.works || [
  { title: "Residência Graciosa", year: "2025", location: "Curitiba, PR", category: "Residencial" },
  { title: "Edifício Nexus Corporate", year: "2024", location: "Curitiba, PR", category: "Corporativo" },
  { title: "Villa Bela Vista", year: "2024", location: "Litoral, PR", category: "Lazer" },
  { title: "Clínica Integrada Batel", year: "2023", location: "Curitiba, PR", category: "Saúde" }
];
---

<section id="obras" class="py-24" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        {content.badge && (
          <span class="text-xs font-mono uppercase tracking-widest block mb-2" style="color: var(--color-accent);">
            {content.badge}
          </span>
        )}
        <h2 class="text-3xl sm:text-5xl font-bold" style="font-family: var(--font-heading);">
          {content.title || "Acervo de Realizações"}
        </h2>
      </div>
      <div class="text-xs font-mono text-slate-400">
        ÍNDICE CRONOLÓGICO // {client.business.city.toUpperCase()}
      </div>
    </div>

    <div class="divide-y divide-white/10 border-y border-white/10">
      {works.map((w, idx) => (
        <div class="py-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover:bg-white/[0.02] px-4 transition-colors">
          <div class="flex items-center gap-6">
            <span class="text-xs font-mono text-slate-500">0{idx + 1}</span>
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:translate-x-1 transition-transform" style="font-family: var(--font-heading);">
                {w.title}
              </h3>
              <div class="text-xs text-slate-400 mt-1">{w.category} • {w.location}</div>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <span class="text-xs font-mono font-bold text-slate-400">{w.year}</span>
            <span class="text-sm font-mono text-slate-500 group-hover:text-white transition-colors">&rarr;</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
