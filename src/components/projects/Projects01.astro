---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    title: string;
    subtitle?: string;
    projects: Array<{
      title: string;
      category?: string;
      description?: string;
    }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const projectList = content?.projects || (content as any)?.items || [];
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-bold" style="font-family: var(--font-heading);">{content?.title || "Projetos Recentes"}</h2>
      {content?.subtitle && <p class="text-sm mt-3 opacity-75">{content.subtitle}</p>}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projectList.map((proj: any) => (
        <div class="p-6 rounded-2xl border border-white/10 hover:border-white/20 transition-all" style="background-color: var(--color-secondary);">
          {proj.category && <span class="text-[10px] uppercase tracking-wider font-bold" style="color: var(--color-accent);">{proj.category}</span>}
          <h3 class="font-bold text-lg mt-1 mb-2" style="font-family: var(--font-heading);">{proj.title}</h3>
          {proj.description && <p class="text-sm opacity-80">{proj.description}</p>}
        </div>
      ))}
    </div>
  </div>
</section>