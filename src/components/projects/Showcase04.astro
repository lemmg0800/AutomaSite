---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    title: string;
    subtitle?: string;
    mainProject: {
      title: string;
      category: string;
      description: string;
      image?: string;
      metrics?: string;
    };
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const main = content?.mainProject || {
  title: "Residência Ecoville Prime",
  category: "Arquitetura Autoral",
  description: "Um manifesto de integração paisagística com interiores amplos, ventilação cruzada e pé-direito duplo de 7 metros.",
  metrics: "1.200m² // Entregue em 2025"
};
---

<section class="py-24 border-y border-white/5" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rounded-3xl border border-white/15 bg-white/[0.02] p-8 sm:p-14 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6">
          <span class="text-xs font-mono uppercase tracking-widest px-3 py-1 rounded-full border border-white/10 bg-white/5 inline-block mb-6" style="color: var(--color-accent);">
            PROJETO EM FOCO
          </span>
          <h2 class="text-3xl sm:text-5xl font-bold text-white mb-4" style="font-family: var(--font-heading);">
            {main.title}
          </h2>
          <p class="text-base text-slate-300 font-light leading-relaxed mb-8">
            {main.description}
          </p>
          <div class="text-xs font-mono text-slate-400">
            {main.metrics} • {client.business.city}
          </div>
        </div>

        <div class="lg:col-span-6 aspect-[4/3] rounded-2xl bg-slate-900 border border-white/10 overflow-hidden flex items-center justify-center">
          {main.image ? (
            <img src={main.image} alt={main.title} class="w-full h-full object-cover" />
          ) : (
            <div class="text-center p-8">
              <div class="text-5xl mb-3" style="color: var(--color-accent);">✦</div>
              <div class="text-xs font-mono text-slate-400 uppercase tracking-widest">{main.category}</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
