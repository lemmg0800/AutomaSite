---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    headline: string;
    subheadline: string;
    ctaLabel?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<section class="py-20" style="background-color: var(--color-secondary);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7">
      <h1 class="text-3xl sm:text-5xl font-bold mb-6" style="font-family: var(--font-heading);">
        {content.headline}
      </h1>
      <p class="text-base sm:text-lg opacity-80 leading-relaxed mb-8">
        {content.subheadline}
      </p>
      <div class="text-sm opacity-90">
        📍 <strong>Localização:</strong> {client.business.address}
      </div>
    </div>
    <div class="lg:col-span-5 p-8 rounded-2xl border border-white/10 shadow-2xl" style="background-color: var(--color-bg);">
      <h3 class="font-bold text-xl mb-3" style="font-family: var(--font-heading);">Fale Conosco Diretamente</h3>
      <p class="text-xs opacity-75 mb-6">Atendimento ágil em {client.business.city}.</p>
      <div class="space-y-3 text-sm">
        <div class="p-3 rounded-lg border border-white/10">📞 Telefone: {client.business.phone}</div>
        <div class="p-3 rounded-lg border border-white/10">💬 WhatsApp: {client.business.whatsapp}</div>
      </div>
    </div>
  </div>
</section>