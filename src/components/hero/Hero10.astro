---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    showcaseTitle?: string;
    showcaseItems?: Array<{ label: string; value: string }>;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const rawPhone = client?.business?.whatsapp || client?.business?.phone || '';
const cleanPhone = rawPhone.replace(/\D/g, '');
const defaultCta = cleanPhone ? `https://wa.me/55${cleanPhone}` : '#contato';

const primaryText = content?.primaryCtaLabel || "Conhecer Soluções";
const primaryLink = content?.primaryCtaHref || defaultCta;
const secondaryText = content?.secondaryCtaLabel;
const secondaryLink = content?.secondaryCtaHref || '#servicos';
---

<section class="relative pt-28 pb-24 lg:pt-36 lg:pb-32 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14">
      {content.badge && (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase mb-6 border border-white/10" style="background-color: color-mix(in srgb, var(--color-accent) 15%, transparent); color: var(--color-accent);">
          <span>✦</span>
          <span>{content.badge}</span>
        </div>
      )}

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight mb-6" style="font-family: var(--font-heading);">
        {content.headline}
      </h1>

      {content.subheadline && (
        <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-8">
          {content.subheadline}
        </p>
      )}

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href={primaryLink}
          target="_blank"
          class="px-8 py-4 rounded-xl font-bold text-sm tracking-wider uppercase transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-xl"
          style="background-color: var(--color-accent); color: var(--color-bg);"
        >
          {primaryText}
        </a>

        {secondaryText && (
          <a 
            href={secondaryLink}
            class="px-6 py-4 rounded-xl border border-white/15 hover:border-white/30 text-sm font-medium transition-all bg-white/[0.03] text-white"
          >
            {secondaryText}
          </a>
        )}
      </div>
    </div>

    <!-- Floating Perspective Showcase Card -->
    <div class="relative max-w-4xl mx-auto rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl backdrop-blur-xl" style="background-color: color-mix(in srgb, var(--color-secondary) 50%, transparent);">
      <div class="flex items-center justify-between border-b border-white/10 pb-6 mb-6">
        <div>
          <div class="text-xs uppercase tracking-widest text-slate-400 font-mono">Painel de Referência</div>
          <div class="text-xl font-bold text-white mt-1" style="font-family: var(--font-heading);">{content.showcaseTitle || client.business.name}</div>
        </div>
        <div class="px-3 py-1 rounded-lg text-xs font-mono border border-white/10" style="color: var(--color-accent);">
          ATIVO
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {(content.showcaseItems || [
          { label: "Localização", value: client.business.city },
          { label: "Segmento", value: client.business.niche },
          { label: "Atendimento", value: "Personalizado" },
          { label: "Padrão", value: "Premium" }
        ]).map(item => (
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/5">
            <div class="text-xs text-slate-400 mb-1">{item.label}</div>
            <div class="text-sm sm:text-base font-bold text-white">{item.value}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
