---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    videoThumbnail?: string;
    videoBadge?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const rawPhone = client?.business?.whatsapp || client?.business?.phone || '';
const cleanPhone = rawPhone.replace(/\D/g, '');
const defaultCta = cleanPhone ? `https://wa.me/55${cleanPhone}` : '#contato';

const primaryText = content?.primaryCtaLabel || "Conhecer Metodologia";
const primaryLink = content?.primaryCtaHref || defaultCta;
const secondaryText = content?.secondaryCtaLabel;
const secondaryLink = content?.secondaryCtaHref || '#servicos';
---

<section class="relative pt-24 pb-28 overflow-hidden text-center">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
    {content.badge && (
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase mb-6 border border-white/10" style="background-color: var(--color-secondary); color: var(--color-accent);">
        <span>✦</span>
        <span>{content.badge}</span>
      </div>
    )}

    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-tight mb-6" style="font-family: var(--font-heading);">
      {content.headline}
    </h1>

    {content.subheadline && (
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed max-w-2xl mx-auto mb-10">
        {content.subheadline}
      </p>
    )}

    <div class="flex flex-wrap items-center justify-center gap-4 mb-14">
      <a 
        href={primaryLink}
        target="_blank"
        class="px-8 py-4 rounded-xl font-bold text-sm tracking-wider uppercase transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-xl"
        style="background-color: var(--color-accent); color: var(--color-bg);"
      >
        {primaryText}
      </a>

      {secondaryText && (
        <a 
          href={secondaryLink}
          class="px-6 py-4 rounded-xl border border-white/15 hover:border-white/30 text-sm font-medium transition-all bg-white/[0.02] text-white"
        >
          {secondaryText}
        </a>
      )}
    </div>

    <!-- Media Video / Mockup Container -->
    <div class="relative max-w-3xl mx-auto rounded-2xl overflow-hidden border border-white/15 shadow-2xl group cursor-pointer aspect-video bg-slate-950 flex items-center justify-center">
      {content.videoThumbnail ? (
        <img src={content.videoThumbnail} alt={content.headline} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-tr from-slate-950 via-slate-900 to-slate-950 flex flex-col items-center justify-center p-6">
          <div class="w-20 h-20 rounded-full flex items-center justify-center shadow-xl border border-white/20 transition-transform group-hover:scale-110" style="background-color: var(--color-accent); color: var(--color-bg);">
            <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
          <div class="mt-4 text-sm font-semibold text-white">{content.videoBadge || `Apresentação Institucional de ${client.business.name}`}</div>
        </div>
      )}
    </div>
  </div>
</section>
