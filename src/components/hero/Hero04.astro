---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    tagline?: string;
    headline: string;
    subheadline?: string;
    primaryCta?: { text: string; href?: string };
    secondaryCta?: { text: string; href?: string };
    stats?: Array<{ value: string; label: string }>;
    image?: string;
    badgeText?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;

const phone = client?.business?.whatsapp || client?.business?.phone;
const cleanPhone = phone ? phone.replace(/\D/g, '') : '';
const defaultCtaLink = cleanPhone ? `https://wa.me/${cleanPhone}` : '#contato';

const primaryHref = content?.primaryCta?.href || defaultCtaLink;
const secondaryHref = content?.secondaryCta?.href || '#servicos';
---

<section class="relative min-h-[90vh] flex items-center justify-center pt-32 pb-20 overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[var(--color-accent)] opacity-15 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        {content?.tagline && (
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase mb-6 border border-white/10 bg-white/5 backdrop-blur-md text-[var(--color-accent)] shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
            <span>{content.tagline}</span>
          </div>
        )}

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1] mb-6">
          {content.headline}
        </h1>

        {content?.subheadline && (
          <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl mb-8">
            {content.subheadline}
          </p>
        )}

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          {content?.primaryCta?.text && (
            <a 
              href={primaryHref} 
              class="w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold text-white transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg flex items-center justify-center gap-2"
              style="background: linear-gradient(135deg, var(--color-accent) 0%, color-mix(in srgb, var(--color-accent) 80%, black) 100%); box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--color-accent) 50%, transparent);"
            >
              <span>{content.primaryCta.text}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          )}

          {content?.secondaryCta?.text && (
            <a 
              href={secondaryHref} 
              class="w-full sm:w-auto px-6 py-4 rounded-xl text-sm font-semibold text-slate-200 border border-white/15 bg-white/5 hover:bg-white/10 hover:text-white transition-all duration-200 backdrop-blur-sm flex items-center justify-center"
            >
              {content.secondaryCta.text}
            </a>
          )}
        </div>

        <!-- Metric Badges -->
        {content?.stats && content.stats.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-10 mt-8 border-t border-white/10 w-full">
            {content.stats.map(stat => (
              <div>
                <div class="text-2xl sm:text-3xl font-bold text-white font-mono">{stat.value}</div>
                <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Right Column: 3D Floating Mockup & Card with Tilt -->
      <div class="lg:col-span-5 relative">
        <div class="tilt-card floating-panel relative rounded-2xl p-4 bg-slate-900/60 border border-white/10 shadow-2xl backdrop-blur-xl">
          {content?.image ? (
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] bg-slate-950">
              <img 
                src={content.image} 
                alt={content.headline} 
                class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            </div>
          ) : (
            <div class="rounded-xl aspect-[4/3] bg-gradient-to-br from-slate-800 to-slate-950 p-6 flex flex-col justify-between border border-white/5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                </div>
                <span class="text-[10px] text-slate-400 font-mono tracking-widest uppercase">EXCELÊNCIA COMPROVADA</span>
              </div>
              <div>
                <div class="text-xl font-bold text-white mb-2">{client.business.name}</div>
                <div class="text-xs text-slate-400">{client.business.niche} em {client.business.city}</div>
              </div>
            </div>
          )}

          <!-- Floating Micro Badge -->
          <div class="absolute -bottom-5 -left-5 bg-slate-900/90 border border-white/15 px-4 py-3 rounded-xl shadow-xl backdrop-blur-md flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-accent)]/20 text-[var(--color-accent)] flex items-center justify-center font-bold text-sm">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Atendimento Estratégico</div>
              <div class="text-[10px] text-slate-400">Direto com especialistas</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
