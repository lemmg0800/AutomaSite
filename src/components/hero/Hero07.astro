---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    badge?: string;
    headline: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    featuredImage?: string;
    trustMetric?: { number: string; text: string };
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const rawPhone = client?.business?.whatsapp || client?.business?.phone || '';
const cleanPhone = rawPhone.replace(/\D/g, '');
const defaultCta = cleanPhone ? `https://wa.me/55${cleanPhone}` : '#contato';

const primaryText = content?.primaryCtaLabel || "Agendar Consulta";
const primaryLink = content?.primaryCtaHref || defaultCta;
const secondaryText = content?.secondaryCtaLabel;
const secondaryLink = content?.secondaryCtaHref || '#servicos';
---

<section class="relative pt-24 pb-20 lg:pt-32 lg:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Coluna Textual -->
      <div class="lg:col-span-7">
        {content.badge && (
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase mb-6 border border-white/10" style="background-color: color-mix(in srgb, var(--color-accent) 15%, transparent); color: var(--color-accent);">
            <span>⚡</span>
            <span>{content.badge}</span>
          </div>
        )}

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12] mb-6" style="font-family: var(--font-heading);">
          {content.headline}
        </h1>

        {content.subheadline && (
          <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-8 max-w-xl">
            {content.subheadline}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-4 mb-10">
          <a 
            href={primaryLink}
            target="_blank"
            class="px-8 py-4 rounded-xl font-bold text-sm tracking-wider uppercase transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-xl flex items-center gap-2"
            style="background-color: var(--color-accent); color: var(--color-bg);"
          >
            <span>{primaryText}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          {secondaryText && (
            <a 
              href={secondaryLink}
              class="px-6 py-4 rounded-xl border border-white/15 hover:border-white/30 text-sm font-medium transition-all bg-white/[0.02] hover:bg-white/[0.05] text-white"
            >
              {secondaryText}
            </a>
          )}
        </div>

        {content.trustMetric && (
          <div class="inline-flex items-center gap-4 p-3 pr-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="text-2xl font-mono font-bold" style="color: var(--color-accent);">{content.trustMetric.number}</div>
            <div class="text-xs text-slate-400 font-medium">{content.trustMetric.text}</div>
          </div>
        )}
      </div>

      <!-- Coluna Visual / Split Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl p-2 bg-gradient-to-b from-white/10 to-transparent border border-white/10 shadow-2xl overflow-hidden group">
          {content.featuredImage ? (
            <img 
              src={content.featuredImage} 
              alt={content.headline} 
              class="w-full aspect-[4/3] object-cover rounded-xl transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            <div class="w-full aspect-[4/3] rounded-xl flex flex-col items-center justify-center p-8 text-center" style="background-color: var(--color-secondary);">
              <div class="w-16 h-16 rounded-2xl mb-4 flex items-center justify-center text-3xl shadow-inner border border-white/10" style="background-color: var(--color-bg); color: var(--color-accent);">
                ✦
              </div>
              <div class="text-lg font-bold text-white mb-1" style="font-family: var(--font-heading);">{client.business.name}</div>
              <div class="text-xs text-slate-400">{client.business.niche} de Referência</div>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</section>
