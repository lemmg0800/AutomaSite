---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    disclaimer?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<footer class="mt-auto py-16 border-t border-white/10" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12 text-xs">
      <div class="col-span-2">
        <div class="text-xl font-bold text-white mb-2" style="font-family: var(--font-heading);">{client.business.name}</div>
        <p class="text-slate-400 font-light max-w-sm mb-4 leading-relaxed">
          {client.business.niche} em {client.business.city}. Excelência comprovada em cada detalhe construtivo.
        </p>
        <div class="text-slate-500 font-mono text-[11px]">STATUS OPERACIONAL: ATIVO</div>
      </div>

      <div>
        <div class="font-mono text-slate-500 uppercase tracking-wider mb-3">Atuação</div>
        <ul class="space-y-2 text-slate-300">
          <li>Residencial</li>
          <li>Comercial</li>
          <li>Interiores</li>
        </ul>
      </div>

      <div>
        <div class="font-mono text-slate-500 uppercase tracking-wider mb-3">Institucional</div>
        <ul class="space-y-2 text-slate-300">
          <li><a href="#sobre" class="hover:text-white">Sobre Nós</a></li>
          <li><a href="#diferenciais" class="hover:text-white">Diferenciais</a></li>
          <li><a href="#contato" class="hover:text-white">Contato</a></li>
        </ul>
      </div>

      <div>
        <div class="font-mono text-slate-500 uppercase tracking-wider mb-3">Contato</div>
        <div class="text-slate-300 leading-relaxed">
          {client.business.phone || "Atendimento Direto"}<br />
          {client.business.city}
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 text-center text-xs text-slate-500">
      © {new Date().getFullYear()} {client.business.name}. Todos os direitos reservados.
    </div>
  </div>
</footer>
