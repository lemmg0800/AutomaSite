---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    disclaimer?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
const logoSrc = (content as any)?.logo || client?.business?.logo;
---

<footer class="mt-auto py-20 border-t border-white/10" style="background-color: var(--color-bg);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between pb-16 border-b border-white/10 gap-8">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-slate-400 block mb-3">CONECTE-SE DIRETAMENTE</span>
        {logoSrc ? (
          <img src={logoSrc} alt={client.business.name} class="h-10 sm:h-12 w-auto object-contain mb-3" />
        ) : null}
        <div class="text-3xl sm:text-5xl font-bold tracking-tight text-white" style="font-family: var(--font-heading);">
          {client.business.name}
        </div>
      </div>
      <div class="text-sm font-mono text-slate-400">
        {client.business.city.toUpperCase()} // BRASIL
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>© {new Date().getFullYear()} {client.business.name}. Todos os direitos reservados.</div>
      <div class="flex gap-6 text-slate-400">
        <a href="#servicos" class="hover:text-white">Serviços</a>
        <a href="#sobre" class="hover:text-white">Sobre</a>
        <a href="#contato" class="hover:text-white">Contato</a>
      </div>
    </div>
  </div>
</footer>
