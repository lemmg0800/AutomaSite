---
import type { ClientConfig } from '../../clients/schema';

interface Props {
  content: {
    disclaimer?: string;
  };
  client: ClientConfig;
}

const { content, client } = Astro.props;
---

<footer class="mt-auto py-16 border-t border-white/10" style="background-color: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="p-8 sm:p-12 rounded-3xl border border-white/10 bg-white/[0.02] flex flex-col md:flex-row items-center justify-between gap-6 mb-12">
      <div>
        <div class="text-xl font-bold text-white mb-1" style="font-family: var(--font-heading);">{client.business.name}</div>
        <div class="text-xs text-slate-400">Atendimento presencial e online em {client.business.city}</div>
      </div>
      <a href="#contato" class="px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider" style="background-color: var(--color-accent); color: var(--color-bg);">
        Iniciar Conversa
      </a>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>© {new Date().getFullYear()} {client.business.name}. Todos os direitos reservados.</div>
      <div class="flex gap-6">
        <a href="#servicos" class="hover:text-white">Serviços</a>
        <a href="#sobre" class="hover:text-white">Sobre</a>
      </div>
    </div>
  </div>
</footer>
