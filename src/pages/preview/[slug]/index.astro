---
export const prerender = false;

import { resolveClient } from '../../../clients/registry';
import { getSupabaseServerClient } from '../../../lib/supabase';

// Rota de Preview: Exige autenticação para visualizar sites que não estão publicados
const { slug } = Astro.params;

if (!slug) {
  return new Response("Slug não informado", { status: 400 });
}

const client = await resolveClient(slug);
if (!client) {
  return new Response(`Cliente "${slug}" não localizado.`, { status: 404 });
}

// Se o cliente for draft/review/arquivado, exige login
if (client.status !== 'published' && client.status !== 'ativo') {
  try {
    const supabase = getSupabaseServerClient(Astro.cookies, Astro.request);
    const { data: { user }, error } = await supabase.auth.getUser();
    if (error || !user) {
      return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
    }
  } catch {
    return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
  }
}

return Astro.redirect(`/site/${slug}`);
---